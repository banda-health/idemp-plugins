<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" output="bin" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry exported="true" kind="lib" path="lib/pdfbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-logging.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/fontbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/hamcrest.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/junit-jupiter-api.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/opentest4j.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/junit-platform-commons.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/poi.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/poi-ooxml.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-io.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-collections4.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/xmlbeans.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/log4j-api.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-compress.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/poi-ooxml-lite.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
