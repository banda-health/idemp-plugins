##
## Build Configuration
##
# Shared keys below auto-sync with dev-docker/.env (bidirectional; see dev-docker/scripts/sync-env.sh).
# Precedence on conflict: whichever file was saved most recently wins; tie → dev-docker/.env.
# Use ./dev.sh or scripts/compose.sh so sync runs before compose reads this file.
CONTAINER_NAME=test
IDEMPIERE_FRESH_DB=false
MIGRATE_EXISTING_DATABASE=false
GENERATE_PLUGIN_BUNDLE_INFO=true
HEALTHY_AFTER_PLUGINS_START=true
# URL test containers use to reach iDempiere (CI / TeamCity root docker-compose.yml).
# Dev tests via ./dev.sh test derive http://host.docker.internal:<IDEMPIERE_HTTP_PORT> at runtime.
# IDEMPIERE_HTTP_PORT lives in dev-docker/.env only (Eclipse container host port mapping).
IDEMPIERE_ENDPOINT=http://idempiere:8080
# ↔ dev-docker EXTERNAL_MOCKS_PORT
EXTERNAL_MOCKS_PORT=8081
EXTERNAL_MOCKS_ENDPOINT=http://external-mocks

##
## iDempiere Configuration
##
IDEMPIERE_PORT=9877
IDEMPIERE_SSL_PORT=8445
TELNET_PORT=12614
IDEMPIERE_VERSION=12
# ↔ dev-docker (same key names)
IDEMPIERE_USER=SuperUser
IDEMPIERE_USER_PASSWORD=System
IDEMPIERE_GRAPHQL_TEST_CLIENT="GraphQL Test Client"
INSTALLATION_HOME=/home/src
# Set this to ensure GraphQL tokens are persisted across iDempier restarts
#GRAPHQL_ENVIRONMENT_SECRET=
# Uncomment below to allow unsecure cookies (such as when testing locally but off localhost)
#DISABLE_GRAPHQL_SECURE_COOKIE_FLAG=true
# Required when syncing concepts from production OCL (api.openconceptlab.org)
#OCL_API_TOKEN=

##
## OCL Configuration
##
# Override for local testing (docker-compose sets this to external-mocks automatically)
#OCL_BASE_URL=https://api.openconceptlab.org
# GraphQL proxy upstream (CI/dev docker-compose set this to external-mocks /graphql-proxy)
#GRAPHQL_PROXY_UPSTREAM_URL=

##
## DB Configuration
##
# ↔ dev-docker DB_UPSTREAM_DATABASE
DB_NAME=idempiere
# ↔ dev-docker DB_UPSTREAM_PASSWORD
IDEMPIERE_DATABASE_PASSWORD=adempiere
# ↔ dev-docker DB_TARGET=host → host.docker.internal; compose → postgres
POSTGRES_HOST=postgres
# ↔ dev-docker DB_HOST_PORT (when DB_TARGET=host)
POSTGRES_PORT=5679
# ↔ dev-docker DB_UPSTREAM_ADMIN_PASSWORD
POSTGRES_PASSWORD=7d%opWw2N0^f3mG5OmH%