##
## Build Configuration
##
CONTAINER_NAME=test
IDEMPIERE_FRESH_DB=false
MIGRATE_EXISTING_DATABASE=false
GENERATE_PLUGIN_BUNDLE_INFO=true
HEALTHY_AFTER_PLUGINS_START=true
IDEMPIERE_ENDPOINT=http://idempiere:8080
EXTERNAL_MOCKS_PORT=8081
EXTERNAL_MOCKS_ENDPOINT=http://external-mocks

##
## iDempiere Configuration
##
IDEMPIERE_PORT=9877
IDEMPIERE_SSL_PORT=8445
TELNET_PORT=12614
IDEMPIERE_VERSION=12
IDEMPIERE_USER=SuperUser
IDEMPIERE_USER_PASSWORD=System
IDEMPIERE_GRAPHQL_TEST_CLIENT=GraphQL Test Client
INSTALLATION_HOME=/home/src
# Set this to ensure GraphQL tokens are persisted across iDempier restarts
#GRAPHQL_ENVIRONMENT_SECRET=
# Uncomment below to allow unsecure cookies (such as when testing locally but off localhost)
#DISABLE_GRAPHQL_SECURE_COOKIE_FLAG=true
# Required when syncing concepts from production OCL (api.openconceptlab.org)
#OCL_API_TOKEN=

##
## OCL Configuration
##
# Override for local testing (docker-compose sets this to external-mocks automatically)
#OCL_BASE_URL=https://api.openconceptlab.org

##
## DB Configuration
##
DB_NAME=idempiere
IDEMPIERE_DATABASE_PASSWORD=adempiere
# Make this host name match your service name unless you have an external DB
POSTGRES_HOST=postgres
POSTGRES_PORT=5679
POSTGRES_PASSWORD=7d%opWw2N0^f3mG5OmH%