{
	"compilerOptions": {
		"target": "es2022",
		"types": ["node", "jest"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "node16",
		"moduleResolution": "node16",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noFallthroughCasesInSwitch": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"compileOnSave": true,
	"include": ["src/**/*"]
}
