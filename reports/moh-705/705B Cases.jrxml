	<subDataset name="Cases" uuid="689199df-9e13-433a-ad4a-b19e5570c3b6">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="567"/>
		<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="422"/>
		<parameter name="Begin Date" class="java.sql.Timestamp"/>
		<parameter name="End Date" class="java.sql.Timestamp"/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[WITH date_limitter AS (
	SELECT
		GENERATE_SERIES(date($P{Begin Date}), date($P{End Date}), '1d')::date AS calendar
	ORDER BY calendar
),
	diagnosis_list AS (
		SELECT DISTINCT
			bh_value AS diagnosis
		FROM
			bh_concept_extra
		WHERE
			bh_value NOT IN
			('NA', 'COVID-19 - suspected', 'COVID-19 - confirmed', 'Tonsillitis', 'Diarrhea with some dehydration',
			 'Diarrhea with severe dehydration', 'Other Diseases Of Respiratory System', 'Sexual Assault', 'Kalaazar',
			 'Fevers', 'Eye Infections', 'Dracunculiasis (Guinea Worm)', 'Neoplasms', 'Newly Diagnosed HIV',
			 'Other Central Nervous System Conditions', 'Other Convulsive Disorders', 'Other Eye Conditions', 'Plague',
			 'Diarrhea', 'Congenital Anomalies', 'Chromosomal Abnormalities (E.G Downs Syndrome; Edwards Syndrome Etc.)',
			 'Cerebral Palsy', 'Autism')
			AND LOWER(bh_key) = 'moh-705b-greaterthan5'
	),
	visit_diagnoses AS (
		SELECT
			v.bh_visit_id,
			ev.bh_concept_id,
			ev.bh_uncoded_diagnosis
		FROM
			bh_visit v
				JOIN bh_encounter e
				ON v.bh_visit_id = e.bh_visit_id
				JOIN bh_encounter_diagnosis ev
				ON e.bh_encounter_id = ev.bh_encounter_id
		WHERE
			v.bh_visit_id IN (
				SELECT bh_visit_id FROM c_order WHERE docstatus IN ('CO', 'CL') AND ad_client_id = $P{AD_CLIENT_ID}
			)
			AND bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
			AND COALESCE(bh_patienttype, '') != 'Im'
	),
	diagnosis_count AS (
		SELECT DISTINCT
			ce.bh_value                AS diagnosis,
			CAST(bh_visitdate AS date) AS calendar,
			COUNT(pd.bh_concept_id)    AS noofdiagnosis
		FROM
			bh_visit v
				JOIN visit_diagnoses pd
				ON pd.bh_visit_id = v.bh_visit_id
				JOIN bh_concept c
				ON pd.bh_concept_id = c.bh_concept_id
				JOIN (
				SELECT
					bh_concept_id,
					bh_value
				FROM
					bh_concept_extra
				WHERE
					LOWER(bh_key) = 'moh-705b-greaterthan5'
					AND isactive = 'Y'
				GROUP BY bh_concept_id, bh_value
			) ce
				ON c.bh_concept_id = ce.bh_concept_id
				JOIN c_bpartner bp
				ON v.patient_id = bp.c_bpartner_id
		WHERE
			bp.bh_birthday IS NOT NULL
			AND DATE_PART('year', AGE(bp.bh_birthday)) >= 5
			AND bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
		GROUP BY ce.bh_value, CAST(bh_visitdate AS DATE)
		ORDER BY CAST(bh_visitdate AS date)
	)
SELECT
	dl.diagnosis,
	dali.calendar,
	COALESCE(dc.noofdiagnosis, 0) AS noofdiagnosis
-- c.calendar
FROM
	diagnosis_list dl
		CROSS JOIN date_limitter dali
		LEFT JOIN diagnosis_count dc
		ON dc.calendar = dali.calendar
		AND dl.diagnosis = dc.diagnosis
		JOIN (
		VALUES
			('Diarrhea', 10),
			('Tuberculosis', 20),
			('Dysentery (Bloody Diarrhea)', 30),
			('Cholera', 40),
			('Meningococcal Meningitis', 50),
			('Other Meningitis', 60),
			('Tetanus (not neonatal)', 70),
			('Poliomyelitis (AFP)', 80),
			('Chickenpox', 90),
			('Measles', 100),
			('Hepatitis', 110),
			('Mumps', 120),
			('Suspected Malaria', 130),
			('Tested for malaria', 135),
			('Confirmed Malaria (Only Positive Cases)', 140),
			('Malaria in Pregnancy', 150),
			('Amoebiasis', 160),
			('Typhoid Fever', 170),
			('Sexually Transmitted Infections', 180),
			('Urinary Tract Infection', 190),
			('Bilharzia', 200),
			('Intestinal Worms', 210),
			('Malnutrition', 220),
			('Anemia', 230),
			('Eye Infections/conditions', 240),
			('Ear infections / conditions', 250),
			('Upper Respiratory Tract Infections', 260),
			('Asthma', 270),
			('Pneumonia', 280),
			('Other Lower Respiratory Tract Infection', 290),
			('Abortion', 300),
			('Diseases of Puerperium and Childbirth', 310),
			('Hypertension', 320),
			('Mental Disorders', 330),
			('Dental Disorders', 340),
			('Jiggers Infestation', 350),
			('Diseases Of The Skin', 360),
			('Arthritis; Joint pains; etc', 370),
			('Poisoning', 380),
			('Road Traffic Injuries', 390),
			('Deaths Due To Road Traffic Injuries', 400),
			('Other Injuries', 410),
			('Sexual violence', 420),
			('Violence Related Injuries', 430),
			('Burns', 440),
			('Snakebites', 450),
			('Dog Bites', 460),
			('Other Bites', 470),
			('Diabetes', 480),
			('Epilepsy', 490),
			('Brucellosis', 500),
			('Cardiovascular Conditions', 510),
			('Central Nervous System Conditions', 520),
			('Overweight (BMI>25)', 530),
			('Musculoskeletal Conditions', 540),
			('Fistula (birth related)', 550),
			('Suspected Neoplasms/Cancers', 560),
			('Physical Disability', 570),
			('Trypanosomiasis', 580),
			('Rift Valley Fever', 590),
			('Yellow Fever', 600),
			('Viral Hemorrhagic Fever', 610),
			('Chikugunya', 620),
			('Dengue Fever', 630),
			('Leishmaniasis (Kalaazar)', 640),
			('Cutaneous leishmaniasis', 650),
			('Suspected Anthrax', 660),
			('All Other Diseases', 670)
	) dlo (diagnosis, "order")
		ON dl.diagnosis = dlo.diagnosis
ORDER BY
	dlo."order", dali.calendar]]>
		</queryString>
		<field name="diagnosis" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="diagnosis"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_concept"/>
		</field>
		<field name="calendar" class="java.sql.Date">
			<property name="com.jaspersoft.studio.field.label" value="calendar"/>
		</field>
		<field name="noofdiagnosis" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.label" value="noofdiagnosis"/>
		</field>
		<group name="diagnosis">
			<groupExpression><![CDATA[$F{diagnosis}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
	COALESCE(l.address1, '') AS county,
	COALESCE(l.address2, '') AS subcounty,
	COALESCE(l.address3, '') AS ward,
	cl.name                  AS name
FROM
	ad_client cl
		JOIN (
		SELECT *
		FROM
			ad_orginfo
		WHERE
			ad_client_id = $P{AD_CLIENT_ID}
		ORDER BY ad_org_id
		LIMIT 1
	) oi
		ON cl.ad_client_id = oi.ad_client_id
		LEFT JOIN c_location l
		ON oi.c_location_id = l.c_location_id
WHERE
	cl.ad_client_id = $P{AD_CLIENT_ID}]]>
	</queryString>
	<field name="name" class="java.lang.String"/>
	<field name="county" class="java.lang.String"/>
	<field name="subcounty" class="java.lang.String"/>
	<field name="ward" class="java.lang.String"/>
