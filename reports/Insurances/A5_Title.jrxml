	<field name="client_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="client_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_org"/>
	</field>
	<field name="address" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="address"/>
	</field>
	<field name="phone" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="phone"/>
	</field>
	<field name="header" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="header"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_orginfo"/>
	</field>
	<field name="city" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="city"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_location"/>
	</field>
	<title>
		<band height="57" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="false">
				<reportElement x="110" y="0" width="250" height="56" isPrintInFirstWholeBand="true" isPrintWhenDetailOverflows="true" uuid="b1cec7ed-c752-4275-bf7c-5ba2ab438e41"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{header} != null && !$F{header}.isEmpty() ? $F{header} :
  (UPPER($F{client_name}) + "\n" +
	($F{address} != null && !$F{address}.isEmpty() ? $F{address} + "\n" : "") +
	($F{phone} != null && !$F{phone}.isEmpty() ? $F{phone} : "")
  ) 
]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Center" onErrorType="Blank">
				<reportElement mode="Transparent" x="0" y="0" width="100" height="56" uuid="bc227f3b-fe3c-41e4-a1cf-1d87a72499f4">
