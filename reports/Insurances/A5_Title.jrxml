<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ClientHeader" pageWidth="360" pageHeight="595" columnWidth="360" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="63c2a694-3a2f-4d1f-9525-1e929535ae92">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="iDempiere Docker PostgreSQL"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="599"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="388"/>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	o.ad_org_id,
	logo.binarydata                    AS image,
	o.name                             AS Client_name,
	REPLACE(REPLACE(
            CONCAT(l.address1 || ', ', l.address2 || ', ',
                   l.address3 || ', ', l.address4 || ', ')
	        || '#END#', ', #END#', ''),
	        '#END#', '') AS address,
	COALESCE(oi.phone, oi.phone2)      AS phone,
	oi.bh_header                       AS header,
	city
FROM
	bh_visit v
		JOIN ad_org o
		ON v.ad_client_id = o.ad_client_id
		INNER JOIN ad_orginfo oi
		ON o.ad_org_id = oi.ad_org_id
		LEFT JOIN c_location l
		ON oi.c_location_id = l.c_location_id
		LEFT JOIN ad_image logo
		ON oi.logo_id = logo.ad_image_id
WHERE
	v.bh_visit_uu = $P{BH_Visit_UU}]]>
	</queryString>
	<field name="ad_org_id" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="ad_org_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_org"/>
	</field>
	<field name="image" class="java.lang.Object">
		<property name="com.jaspersoft.studio.field.label" value="image"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_image"/>
