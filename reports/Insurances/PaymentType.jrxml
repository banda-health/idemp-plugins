<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PaymentType" pageWidth="595" pageHeight="595" whenNoDataType="NoPages" columnWidth="575" leftMargin="0" rightMargin="20" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="6743d9c0-5001-4d7d-898e-ac27cd79ff21">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH visit AS (
	SELECT bh_visit_id, patient_id FROM bh_visit WHERE bh_visit_uu = $P{BH_Visit_UU}
)
SELECT
	charges.symbol           AS charge_symbol,
	charges.visit_grandtotal AS total_charged,
	payments.paid            AS paid,
	payments.tender_type     AS tender_type,
	payments.symbol          AS tender_symbol
FROM
	(
		SELECT
			o.bh_visit_id,
			c.iso_code        AS symbol,
			SUM(o.grandtotal) AS visit_grandtotal
		FROM
			c_order o
				JOIN visit v
				ON v.bh_visit_id = o.bh_visit_id
				JOIN c_currency c
				ON o.c_currency_id = c.c_currency_id
		WHERE
			o.issotrx = 'Y'
		GROUP BY o.bh_visit_id, c.iso_code
	) charges
		LEFT JOIN (
		SELECT
			p.bh_visit_id,
			SUM(p.payamt) AS paid,
			rl.name       AS tender_type,
			iso_code      AS symbol
		FROM
			c_payment p
				JOIN visit v
				ON v.bh_visit_id = p.bh_visit_id AND p.c_bpartner_id = v.patient_id
				LEFT JOIN ad_ref_list rl
				ON p.tendertype = rl.value AND ad_reference_id = 214
				LEFT JOIN c_currency c
				ON p.c_currency_id = c.c_currency_id
		GROUP BY
			p.bh_visit_id, rl.name, iso_code
	) payments
		ON charges.bh_visit_id = payments.bh_visit_id]]>
	</queryString>
