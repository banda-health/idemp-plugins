	<subDataset name="tableDataset" uuid="893302d0-3399-4789-9b40-faf0bf7f6d9a">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres UAT2 "/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT
	bp.name                                AS patient_name,
	bp.bh_local_patientid                  AS patient_number,
	DATE_PART('year', AGE(bp.bh_birthday)) AS age,
	bp.bh_gender                           AS gender,
	bp.bh_phone                            AS phone_number,
	bp.totalopenbalance                    AS openbalance
FROM
	c_bpartner bp
		JOIN c_bp_group cbg
		ON bp.c_bp_group_id = cbg.c_bp_group_id AND cbg.NAME = 'Patients - DO NOT CHANGE'
WHERE
	bp.ad_client_id = $P{AD_CLIENT_ID}
	AND bp.isactive = 'Y'
ORDER BY
	bp.name;]]>
		</queryString>
		<field name="patient_name" class="java.lang.String"/>
		<field name="patient_number" class="java.lang.String"/>
		<field name="age" class="java.lang.Double"/>
		<field name="gender" class="java.lang.String"/>
		<field name="phone_number" class="java.lang.String"/>
		<field name="openbalance" class="java.lang.String"/>
	</subDataset>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 1;]]>
	</queryString>
