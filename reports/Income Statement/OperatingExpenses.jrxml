	<style name="textBackground" mode="Opaque" backcolor="#E6E6FA" pattern=""/>
	<style name="titleBackground" mode="Opaque" backcolor="#00008B"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	c.name                  AS expense,
	SUM(il.linenetamt) * -1 AS amount
FROM
	c_invoice i
		JOIN c_invoiceline il
		ON i.c_invoice_id = il.c_invoice_id
		JOIN c_charge c
		ON il.c_charge_id = c.c_charge_id
WHERE
	i.ad_client_id = $P{AD_CLIENT_ID}
	AND i.docstatus = 'CO'
	AND i.issotrx = 'N'
	AND i.bh_visit_id IS NULL
	AND i.dateinvoiced::date + i.updated::time BETWEEN $P{Begin Date} AND $P{End Date}
	AND c.name != 'Medications & Supplies'
GROUP BY
	c.name
ORDER BY
	c.name;]]>
	</queryString>
	<field name="expense" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="expense"/>
		<property name="com.jaspersoft.studio.field.label" value="expense"/>
	</field>
	<field name="amount" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="amount"/>
		<property name="com.jaspersoft.studio.field.label" value="amount"/>
	</field>
	<variable name="expenseTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
