	<subDataset name="Dataset1" uuid="1249eb05-7d8a-44b8-b5d9-d03f7babd9eb">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<queryString>
			<![CDATA[]]>
		</queryString>
	</subDataset>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	c.name                                                          AS client_name,
	COALESCE(SUM(linenetamt) FILTER ( WHERE producttype = 'I' ), 0) AS product_sales,
	COALESCE(SUM(linenetamt) FILTER ( WHERE producttype = 'S' ), 0) AS service_revenue,
	cogs.cogs * -1                                                  AS product_purchases
FROM
	ad_client c
		LEFT JOIN (
		SELECT
			p.producttype,
			linenetamt
		FROM
			c_orderline ol
				JOIN c_order o
				ON ol.c_order_id = o.c_order_id
				JOIN m_product p
				ON ol.m_product_id = p.m_product_id
		WHERE
			o.ad_client_id = $P{AD_CLIENT_ID}
			AND o.dateordered::date + o.updated::time BETWEEN $P{Begin Date} AND $P{End Date}
			AND o.issotrx = 'Y'
			AND o.docstatus IN ('CO', 'CL')
			AND (EXISTS (
				SELECT
					1
				FROM
					m_inoutline iol
						JOIN m_inout io
						ON iol.m_inout_id = io.m_inout_id
				WHERE
					c_orderline_id = ol.c_orderline_id
					AND io.docstatus IN ('CO', 'CL')
			) OR p.producttype = 'S')
	) il
		ON 1 = 1
		LEFT JOIN (
		SELECT
			COALESCE(SUM(cost_of_goods_sold), 0) AS cogs
		FROM
			bh_get_inventory_changes($P{AD_CLIENT_ID}, $P{Begin Date}, $P{End Date})
	) cogs
		ON 1 = 1
WHERE
	c.ad_client_id = $P{AD_CLIENT_ID}
GROUP BY
	c.name, cogs.cogs]]>
	</queryString>
