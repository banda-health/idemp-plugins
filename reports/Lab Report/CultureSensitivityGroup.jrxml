	<parameter name="Group1" class="java.lang.String"/>
	<queryString>
		<![CDATA[WITH cs_header AS (
    SELECT
        COALESCE(spce.bh_value, sp.bh_display_name)                                     AS specimen_source,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'resultStatus'     THEN ed.bh_value END)  AS result_status,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'collectionDate'   THEN ed.bh_value END)  AS collection_date,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'colonyCount'      THEN ed.bh_value END)  AS colony_count,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'colonyCountOther' THEN ed.bh_value END)  AS colony_count_other,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'comment'          THEN ed.bh_value END)  AS comment_text,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'growthResult'     THEN ed.bh_value END)  AS growth_result,
        MAX(CASE WHEN ed.bh_diagnostic_note = 'organism'         THEN ed.bh_value END)  AS organism
    FROM bh_encounter_diagnostic ed
    JOIN bh_concept sp ON ed.selected_panel_id = sp.bh_concept_id
    LEFT JOIN bh_concept_extra spce
        ON sp.bh_concept_id = spce.bh_concept_id AND spce.bh_key = 'cs_specimen_source'
    WHERE ed.group1 = $P{Group1}
    GROUP BY COALESCE(spce.bh_value, sp.bh_display_name)
),
cs_antibiotics AS (
    SELECT
        MAX(CASE WHEN bh_diagnostic_note = 'antibioticName' THEN bh_value END)  AS antibiotic_name,
        MAX(CASE WHEN bh_diagnostic_note = 'potency'        THEN bh_value END)  AS potency,
        MAX(CASE WHEN bh_diagnostic_note = 'result'         THEN bh_value END)  AS result_value,
        MAX(CASE WHEN bh_diagnostic_note = 'interpretation' THEN bh_value END)  AS interpretation,
        MIN(lineno)                                                               AS sort_order
    FROM bh_encounter_diagnostic
    WHERE group1 = $P{Group1}
      AND bh_diagnostic_note IN ('antibioticName', 'potency', 'result', 'interpretation')
    GROUP BY bh_concept_id

    UNION ALL

    SELECT
        SPLIT_PART(bh_value, '|', 1)  AS antibiotic_name,
        SPLIT_PART(bh_value, '|', 2)  AS potency,
        SPLIT_PART(bh_value, '|', 3)  AS result_value,
        SPLIT_PART(bh_value, '|', 4)  AS interpretation,
        lineno                         AS sort_order
    FROM bh_encounter_diagnostic
    WHERE group1 = $P{Group1}
      AND bh_diagnostic_note = 'manualAntibiotic'
)
SELECT
    h.specimen_source,
    h.result_status,
    h.collection_date,
    h.colony_count,
    h.colony_count_other,
    h.comment_text,
    h.growth_result,
    h.organism,
    a.antibiotic_name,
    a.potency,
    a.result_value,
    a.interpretation,
    a.sort_order
FROM cs_antibiotics a
CROSS JOIN cs_header h
UNION ALL
SELECT
    h.specimen_source,
    h.result_status,
    h.collection_date,
    h.colony_count,
    h.colony_count_other,
    h.comment_text,
    h.growth_result,
    h.organism,
    NULL AS antibiotic_name,
    NULL AS potency,
    NULL AS result_value,
    NULL AS interpretation,
    0 AS sort_order
FROM cs_header h
WHERE NOT EXISTS (SELECT 1 FROM cs_antibiotics)
ORDER BY sort_order NULLS LAST]]>
	</queryString>
