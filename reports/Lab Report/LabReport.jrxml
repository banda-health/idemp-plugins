	<style name="Default" isDefault="true" fontName="Arial"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	v.bh_visitdate  AS date,
	v.documentno    AS visit_number,
	bp.name         AS patient,
	CASE
		WHEN bp.bh_birthday IS NULL THEN NULL
		WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) >= 2
			THEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date))::int || ' years'
		WHEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
			+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int >= 2
			THEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
				+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int || ' months'
		WHEN (CURRENT_DATE - bp.bh_birthday::date) >= 15
			THEN (CURRENT_DATE - bp.bh_birthday::date) / 7 || ' weeks'
				|| CASE
					WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 0 THEN ''
					WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 1 THEN ', 1 day'
					ELSE ', ' || (CURRENT_DATE - bp.bh_birthday::date) % 7 || ' days'
				END
		WHEN (CURRENT_DATE - bp.bh_birthday::date) = 1 THEN '1 day'
		ELSE (CURRENT_DATE - bp.bh_birthday::date) || ' days'
	END AS age,
	bp.bh_gender    AS gender,
	bp.bh_patientid AS patient_id,
	(
		SELECT
			u.name
		FROM
			c_order o
				LEFT JOIN ad_user u
				ON o.salesrep_id = u.ad_user_id
		WHERE
			o.bh_visit_id = v.bh_visit_id
		ORDER BY
			o.c_order_id DESC
		LIMIT 1
	)               AS served_by,
	clinician.name  AS clinician,
	distinct_group.group1
FROM
	bh_visit v
		JOIN bh_encounter be
		ON v.bh_visit_id = be.bh_visit_id
		JOIN bh_encounter_diagnostic bed
		ON be.bh_encounter_id = bed.bh_encounter_id
		JOIN (
		SELECT
			bh_encounter_id,
			group1,
			MIN(lineno) AS lineno
		FROM
			bh_encounter_diagnostic
		WHERE
			bh_value IS NOT NULL
		GROUP BY bh_encounter_id, group1
	) distinct_group
		ON bed.bh_encounter_id = distinct_group.bh_encounter_id AND bed.lineno = distinct_group.lineno
		JOIN c_bpartner bp
		ON v.patient_id = bp.c_bpartner_id
		LEFT JOIN ad_orginfo oi
		ON v.ad_org_id = oi.ad_org_id
		LEFT JOIN ad_user clinician
		ON v.bh_clinician_user_id = clinician.ad_user_id
WHERE
	v.bh_visit_uu = $P{BH_Visit_UU}
ORDER BY
	bed.lineno]]>
	</queryString>
