<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="moh706LeftSide" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15" uuid="68ef5eae-c2af-4563-879f-bd1fd6ee28fd">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="KB DB 11"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="666"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="320"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_USER_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[WITH desired_ocl_urls (url) AS (
	VALUES
		('/orgs/CIEL/sources/CIEL/concepts/21/'),
		('/orgs/CIEL/sources/CIEL/concepts/32/'),
		('/orgs/CIEL/sources/CIEL/concepts/653/'),
		('/orgs/CIEL/sources/CIEL/concepts/654/'),
		('/orgs/CIEL/sources/CIEL/concepts/655/'),
		('/orgs/CIEL/sources/CIEL/concepts/678/'),
		('/orgs/CIEL/sources/CIEL/concepts/717/'),
		('/orgs/CIEL/sources/CIEL/concepts/729/'),
		('/orgs/CIEL/sources/CIEL/concepts/785/'),
		('/orgs/CIEL/sources/CIEL/concepts/790/'),
		('/orgs/CIEL/sources/CIEL/concepts/848/'),
		('/orgs/CIEL/sources/CIEL/concepts/857/'),
		('/orgs/CIEL/sources/CIEL/concepts/1006/'),
		('/orgs/CIEL/sources/CIEL/concepts/1008/'),
		('/orgs/CIEL/sources/CIEL/concepts/1009/'),
		('/orgs/CIEL/sources/CIEL/concepts/1019/'),
		('/orgs/CIEL/sources/CIEL/concepts/1132/'),
		('/orgs/CIEL/sources/CIEL/concepts/1133/'),
		('/orgs/CIEL/sources/CIEL/concepts/1134/'),
		('/orgs/CIEL/sources/CIEL/concepts/1297/'),
		('/orgs/CIEL/sources/CIEL/concepts/1458/'),
		('/orgs/CIEL/sources/CIEL/concepts/1643/'),
		('/orgs/CIEL/sources/CIEL/concepts/1875/'),
		('/orgs/CIEL/sources/CIEL/concepts/159644/'),
		('/orgs/CIEL/sources/CIEL/concepts/159734/'),
		('/orgs/CIEL/sources/CIEL/concepts/160735/'),
		('/orgs/CIEL/sources/CIEL/concepts/160913/'),
		('/orgs/CIEL/sources/CIEL/concepts/160915/'),
		('/orgs/CIEL/sources/CIEL/concepts/160917/'),
		('/orgs/CIEL/sources/CIEL/concepts/160919/'),
		('/orgs/CIEL/sources/CIEL/concepts/160920/'),
		('/orgs/CIEL/sources/CIEL/concepts/160921/'),
		('/orgs/CIEL/sources/CIEL/concepts/161442/'),
		('/orgs/CIEL/sources/CIEL/concepts/161503/'),
		('/orgs/CIEL/sources/CIEL/concepts/161504/'),
		('/orgs/CIEL/sources/CIEL/concepts/163594/'),
		('/orgs/CIEL/sources/CIEL/concepts/163684/'),
		('/orgs/CIEL/sources/CIEL/concepts/163686/'),
		('/orgs/CIEL/sources/CIEL/concepts/163689/'),
		('/orgs/CIEL/sources/CIEL/concepts/163705/'),
		('/orgs/CIEL/sources/CIEL/concepts/167348/'),
		('/orgs/CIEL/sources/CIEL/concepts/167349/'),
		('/orgs/CIEL/sources/CIEL/concepts/167350/'),
		('/orgs/CIEL/sources/CIEL/concepts/167351/'),
		('/orgs/CIEL/sources/CIEL/concepts/167353/'),
		('/orgs/CIEL/sources/CIEL/concepts/167363/'),
		('/orgs/CIEL/sources/CIEL/concepts/168019/'),
		('/orgs/CIEL/sources/CIEL/concepts/168213/'),
		('/orgs/Regenstrief/sources/LOINC/concepts/10715-1/')
),
	concept_same_as_mappings AS
		(
			SELECT
				dou.url,
				cm.bh_from_concept_url
			FROM
				desired_ocl_urls dou
					JOIN bh_concept_mapping cm
					ON dou.url = cm.bh_to_concept_url AND bh_map_type IN ('SAME-AS', 'Same As') AND
					   bh_from_concept_url != bh_to_concept_url
			UNION ALL
			SELECT
				url,
				url
			FROM
				desired_ocl_urls
		)
SELECT
	cl.name                                                                                                                                      AS facility_name,
	COALESCE(l.address1, '')                                                                                                                     AS county,
	COALESCE(l.address2, '')                                                                                                                     AS sub_county,
	u.name                                                                                                                                       AS compiled_by,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'Negative' AND ed.bh_value != 'Unknown' AND
		                           csam.url =
		                           '/orgs/CIEL/sources/CIEL/concepts/159734/' )                                                                    AS glucose_postive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'Negative' AND
		                           csam.url =
		                           '/orgs/CIEL/sources/CIEL/concepts/161442/' )                                                                    AS ketone_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'Negative' AND
		                           csam.url =
		                           '/orgs/CIEL/sources/CIEL/concepts/1875/' )                                                                      AS proteins_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url IN ('/orgs/CIEL/sources/CIEL/concepts/159734/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/161442/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/1875/') )                            AS urine_chemistry_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/163684/' )              AS puss_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'Negative' AND csam.url =
		                                                                                     '/orgs/CIEL/sources/CIEL/concepts/163686/' )          AS vaginalis_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'Negative' AND csam.url =
		                                                                                     '/orgs/Regenstrief/sources/LOINC/concepts/10715-1/' ) AS haematobium_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value = 'Positive' AND csam.url =
		                                                                                    '/orgs/CIEL/sources/CIEL/concepts/160735/' )           AS bacteria_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/163689/' )              AS yeast_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url IN ('/orgs/CIEL/sources/CIEL/concepts/163684/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/163686/',
		                                                                    '/orgs/Regenstrief/sources/LOINC/concepts/10715-1/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/160735/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/163689/') )                          AS urine_microscopy_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/1458/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC <
		                           3.9)                                                                                                            AS blood_sugar_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/1458/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           7.8)                                                                                                            AS blood_sugar_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1458/' )                                          AS blood_sugar_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND
		                           ((csam.url = '/orgs/CIEL/sources/CIEL/concepts/163594/' AND csam.url IS NOT NULL AND
		                             ed.bh_value::NUMERIC < 3.9) OR
		                            (csam.url = '/orgs/CIEL/sources/CIEL/concepts/163705/' AND csam.url IS NOT NULL AND
		                             ed.bh_value::NUMERIC <
		                             3.9)))                                                                                                        AS ogtt_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND
		                           ((csam.url = '/orgs/CIEL/sources/CIEL/concepts/163594/' AND csam.url IS NOT NULL AND
		                             ed.bh_value::NUMERIC > 7.8) OR
		                            (csam.url = '/orgs/CIEL/sources/CIEL/concepts/163705/' AND csam.url IS NOT NULL AND
		                             ed.bh_value::NUMERIC >
		                             7.8)))                                                                                                        AS ogtt_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url IN ('/orgs/CIEL/sources/CIEL/concepts/163594/',
		                                                                    '/orgs/CIEL/sources/CIEL/concepts/163705/') )                          AS ogtt_total,
		COUNT(ed.*) FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) < 5 AND ed.bh_value IS NOT NULL
		AND ed.bh_value = 'Positive' AND csam.url =
		                                 '/orgs/CIEL/sources/CIEL/concepts/32/' )                                                                  AS malaria_bs_under5,
		COUNT(ed.*) FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) < 5 AND ed.bh_value IS NOT NULL
		AND csam.url =
		    '/orgs/CIEL/sources/CIEL/concepts/32/')                                                                                                AS malaria_bs_under5_total,
		COUNT(ed.*)
		FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) >= 5 AND ed.bh_value IS NOT NULL
			AND ed.bh_value = 'Positive' AND csam.url =
			                                 '/orgs/CIEL/sources/CIEL/concepts/32/')                                                                 AS malaria_bs_over5,
		COUNT(ed.*)
		FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) >= 5 AND ed.bh_value IS NOT NULL
			AND csam.url =
			    '/orgs/CIEL/sources/CIEL/concepts/32/')                                                                                              AS malaria_bs_over5_total,
		COUNT(ed.*)
		FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) < 5 AND ed.bh_value IS NOT NULL AND
		               ed.bh_value ILIKE '%positive%'
			AND csam.url =
			    '/orgs/CIEL/sources/CIEL/concepts/1643/' )                                                                                           AS malaria_rapid_under5,
		COUNT(ed.*) FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) < 5 AND ed.bh_value IS NOT NULL
		AND csam.url =
		    '/orgs/CIEL/sources/CIEL/concepts/1643/' )                                                                                             AS malaria_rapid_under5_total,
		COUNT(ed.*)
		FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) >= 5 AND ed.bh_value IS NOT NULL AND
		               ed.bh_value ILIKE '%positive%'
			AND csam.url =
			    '/orgs/CIEL/sources/CIEL/concepts/1643/' )                                                                                           AS malaria_rapid_over5,
		COUNT(ed.*)
		FILTER ( WHERE EXTRACT(YEAR FROM AGE(bh_visitdate, patient.bh_birthday)) >= 5 AND ed.bh_value IS NOT NULL
			AND csam.url =
			    '/orgs/CIEL/sources/CIEL/concepts/1643/' )                                                                                           AS malaria_rapid_over5_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167353/' )              AS taenia_spp_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167351/' )              AS hymenolepis_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167349/' )              AS hookworm_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167348/' )              AS roundsworms_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/168019/' )              AS s_mansoni_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167350/' )              AS trichuris_trichura_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url =
		                                                                                 '/orgs/CIEL/sources/CIEL/concepts/167363/' )              AS amoeba_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND ed.bh_value != 'None' AND csam.url IN
		                                                                                 ('/orgs/CIEL/sources/CIEL/concepts/167353/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/167351/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/167349/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/167348/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/168019/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/167350/',
		                                                                                  '/orgs/CIEL/sources/CIEL/concepts/167363/') )            AS stool_total,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed_cbc_plt.bh_concept_id IS NOT NULL AND
		               ed_cbc_wbc.bh_concept_id IS NOT NULL )                                                                                      AS full_bloodcount_total,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/21/' AND
		               csam.url IS NOT NULL AND
		               ed.bh_value::NUMERIC < 5 AND ed_cbc_plt.bh_concept_id IS NOT NULL AND
		               ed_cbc_wbc.bh_concept_id IS NOT NULL )                                                                                      AS hb_lessthan5,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/21/' AND
		               csam.url IS NOT NULL AND
		               ed.bh_value::NUMERIC BETWEEN 5 AND 10 AND ed_cbc_plt.bh_concept_id IS NOT NULL AND
		               ed_cbc_wbc.bh_concept_id IS NOT NULL )                                                                                      AS hb_between5and10,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/21/' AND
		               (ed_cbc_wbc.bh_concept_id IS NULL OR
		                ed_cbc_plt.bh_concept_id IS NULL) )                                                                                        AS hb_estimation_total,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/21/' AND
		               csam.url IS NOT NULL AND
		               ed.bh_value::NUMERIC < 5 AND (ed_cbc_wbc.bh_concept_id IS NULL OR
		                                             ed_cbc_plt.bh_concept_id IS NULL) )                                                           AS hb_estimation_lessthan5,
		COUNT(DISTINCT ed.group1)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/21/' AND
		               csam.url IS NOT NULL AND
		               ed.bh_value::NUMERIC BETWEEN 5 AND 10 AND
		               (ed_cbc_wbc.bh_concept_id IS NULL OR
		                ed_cbc_plt.bh_concept_id IS NULL) )                                                                                        AS hb_estimation_between5and10,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/159644/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC BETWEEN 5.7 AND 6.4)                                                                       AS hba1c_prediabetic,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url = '/orgs/CIEL/sources/CIEL/concepts/159644/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >=
		                           6.5)                                                                                                            AS hba1c_diabetic,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                           '/orgs/CIEL/sources/CIEL/concepts/159644/')                                                     AS hba1c_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/790/' )                                           AS creatinine_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/790/' AND
		                           csam.url IS NOT NULL AND CASE
			                                                    WHEN patient_age.months = 0
				                                                    THEN ed.bh_value::numeric < 27
			                                                    WHEN patient_age.years = 0
				                                                    THEN ed.bh_value::numeric < 18
			                                                    WHEN patient_age.years <= 12
				                                                    THEN ed.bh_value::numeric < 27
			                                                    WHEN patient_age.years <= 18
				                                                    THEN CASE
					                                                         WHEN patient.bh_gender = 'male'
						                                                         THEN ed.bh_value::numeric < 53
					                                                         ELSE ed.bh_value::numeric < 44 END
			                                                    ELSE CASE
				                                                         WHEN patient.bh_gender = 'male'
					                                                         THEN ed.bh_value::NUMERIC < 60
				                                                         ELSE ed.bh_value::NUMERIC < 45 END END)                                       AS creatinine_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/790/' AND
		                           csam.url IS NOT NULL AND CASE
			                                                    WHEN patient_age.months = 0
				                                                    THEN ed.bh_value::numeric > 106
			                                                    WHEN patient_age.years = 0
				                                                    THEN ed.bh_value::numeric > 35
			                                                    WHEN patient_age.years <= 12
				                                                    THEN ed.bh_value::numeric > 62
			                                                    WHEN patient_age.years <= 18
				                                                    THEN CASE
					                                                         WHEN patient.bh_gender = 'male'
						                                                         THEN ed.bh_value::numeric > 106
					                                                         ELSE ed.bh_value::numeric > 88 END
			                                                    ELSE CASE
				                                                         WHEN patient.bh_gender = 'male'
					                                                         THEN ed.bh_value::NUMERIC > 110
				                                                         ELSE ed.bh_value::NUMERIC > 90 END END)                                       AS creatinine_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1132/' )                                          AS sodium_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1132/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           135 )                                                                                                           AS sodium_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1132/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           145 )                                                                                                           AS sodium_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/857/' )                                           AS urea_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/857/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           2.1 )                                                                                                           AS urea_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/857/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           7.1 )                                                                                                           AS urea_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1133/' )                                          AS potassium_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1133/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           3.5 )                                                                                                           AS potassium_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1133/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           5.6 )                                                                                                           AS potassium_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1134/' )                                          AS chlorides_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1134/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           96 )                                                                                                            AS chlorides_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1134/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           107 )                                                                                                           AS chlorides_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1297/' )                                          AS direct_bilirubin_total,
	0                                                                                                                                            AS direct_bilirubin_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1297/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           5.1 )                                                                                                           AS direct_bilirubin_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/655/' )                                           AS total_bilirubin_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/655/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           1.71 )                                                                                                          AS total_bilirubin_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/655/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           20.5 )                                                                                                          AS total_bilirubin_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/653/' )                                           AS asat_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/653/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           25 )                                                                                                            AS asat_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/653/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           45 )                                                                                                            AS asat_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/654/' )                                           AS alat_total,

	0                                                                                                                                            AS alat_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/654/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           35 )                                                                                                            AS alat_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/717/' )                                           AS serum_protein_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/717/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           6 )                                                                                                             AS serum_protein_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/717/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           8.3 )                                                                                                           AS serum_protein_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/848/' )                                           AS albumin_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/848/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric <
		                           3.5 )                                                                                                           AS albumin_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/848/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::numeric >
		                           5 )                                                                                                             AS albumin_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/785/' )                                           AS alkaline_phosphatase_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/785/' AND
		                           csam.url IS NOT NULL AND ed.bh_value::numeric < CASE
			                                                                           WHEN patient_age.months = 0 THEN 83
			                                                                           WHEN patient_age.years = 0 THEN 120
			                                                                           WHEN patient_age.years < 10 THEN 140
			                                                                           WHEN patient_age.years < 13 THEN 130
			                                                                           WHEN patient_age.years > 18 THEN 30
			                                                                           WHEN patient.bh_gender = 'male'
				                                                                           THEN CASE
					                                                                                WHEN patient_age.years < 15
						                                                                                THEN 115
					                                                                                WHEN patient_age.years < 17
						                                                                                THEN 80
					                                                                                ELSE 55 END
			                                                                           ELSE CASE
					                                                                                WHEN patient_age.years < 15
						                                                                                THEN 52
					                                                                                WHEN patient_age.years < 17
						                                                                                THEN 50
					                                                                                ELSE 45 END
			END )                                                                                                                                    AS alkaline_phosphatase_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/785/' AND
		                           csam.url IS NOT NULL  AND ed.bh_value::numeric > CASE
			                                                                           WHEN patient_age.months = 0 THEN 380
			                                                                           WHEN patient_age.years = 0 THEN 470
			                                                                           WHEN patient_age.years < 10 THEN 335
			                                                                           WHEN patient_age.years < 13 THEN 420
			                                                                           WHEN patient_age.years > 18 THEN 130
			                                                                           WHEN patient.bh_gender = 'male'
				                                                                           THEN CASE
					                                                                                WHEN patient_age.years < 15
						                                                                                THEN 300
					                                                                                WHEN patient_age.years < 17
						                                                                                THEN 80
					                                                                                ELSE 149 END
			                                                                           ELSE CASE
					                                                                                WHEN patient_age.years < 15
						                                                                                THEN 116
					                                                                                WHEN patient_age.years < 17
						                                                                                THEN 50
					                                                                                ELSE 87 END
			END )                                                                                                           AS alkaline_phosphatase_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1006/' )                                          AS total_cholesterol_total,

	0                                                                                                                                            AS total_cholesterol_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1006/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           5.17 )                                                                                                          AS total_cholesterol_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1009/' )                                          AS triglycerides_total,

	0                                                                                                                                            AS triglycerides_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1009/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           2.26 )                                                                                                          AS triglycerides_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1008/' )                                          AS ldl_total,

	0                                                                                                                                            AS ldl_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/1008/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           3.4 )                                                                                                           AS ldl_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161503/' )                                        AS t3_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161503/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC <
		                           0.2 )                                                                                                           AS t3_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161503/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           0.5 )                                                                                                           AS t3_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161504/' )                                        AS t4_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161504/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC <
		                           4.5 )                                                                                                           AS t4_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/161504/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           12.5 )                                                                                                          AS t4_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/168213/' )                                        AS tsh_total,

		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/168213/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC <
		                           0.4 )                                                                                                           AS tsh_low,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/168213/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           4.5 )                                                                                                           AS tsh_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160913/' )                                        AS psa_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160913/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           4 )                                                                                                             AS psa_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160920/' )                                        AS ca15_3_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160920/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           30 )                                                                                                            AS ca15_3_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160921/' )                                        AS ca19_9_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160921/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           37 )                                                                                                            AS ca19_9_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160919/' )                                        AS ca125_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160919/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           35 )                                                                                                            AS ca125_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160915/' )                                        AS cea_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160915/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           3 )                                                                                                             AS cea_high,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160917/' )                                        AS afp_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND csam.url =
		                                                       '/orgs/CIEL/sources/CIEL/concepts/160917/' AND
		                           csam.url IS NOT NULL AND
		                           ed.bh_value::NUMERIC >
		                           10 )                                                                                                            AS afp_high
FROM
	ad_client cl
		LEFT JOIN bh_visit v
		ON v.ad_client_id = cl.ad_client_id AND v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
		LEFT JOIN bh_encounter e
		ON v.bh_visit_id = e.bh_visit_id
		LEFT JOIN bh_encounter_diagnostic ed
		ON e.bh_encounter_id = ed.bh_encounter_id
		LEFT JOIN bh_concept c
		ON ed.bh_concept_id = c.bh_concept_id
		LEFT JOIN concept_same_as_mappings csam
		ON c.url = csam.bh_from_concept_url
		LEFT JOIN c_bpartner patient
		ON patient.c_bpartner_id = v.patient_id
		LEFT JOIN LATERAL bh_get_age_interval_changes(COALESCE(bh_birthday, NOW())) patient_age
		ON TRUE
		LEFT JOIN bh_encounter_diagnostic ed_cbc_plt
		ON ed_cbc_plt.group1 = ed.group1 AND ed_cbc_plt.bh_value IS NOT NULL AND
		   ed_cbc_plt.bh_concept_id IN (
			   SELECT
				   bh_concept_id
			   FROM
				   bh_concept
			   WHERE
				   url IN (
					   SELECT
						   bh_from_concept_url
					   FROM
						   concept_same_as_mappings
					   WHERE
						   url = '/orgs/CIEL/sources/CIEL/concepts/678/'
				   )
		   )
		LEFT JOIN bh_encounter_diagnostic ed_cbc_wbc
		ON ed_cbc_wbc.group1 = ed.group1 AND ed_cbc_wbc.bh_value IS NOT NULL AND
		   ed_cbc_wbc.bh_concept_id IN (
			   SELECT
				   bh_concept_id
			   FROM
				   bh_concept
			   WHERE
				   url IN (
					   SELECT
						   bh_from_concept_url
					   FROM
						   concept_same_as_mappings
					   WHERE
						   url = '/orgs/CIEL/sources/CIEL/concepts/729/'
				   )
		   )
		CROSS JOIN ad_user u
		JOIN (
		SELECT *
		FROM
			ad_orginfo
		WHERE
			ad_client_id = $P{AD_CLIENT_ID}
		LIMIT 1
	) oi
		ON cl.ad_client_id = oi.ad_client_id
		LEFT JOIN (
		SELECT *
		FROM
			c_location
		WHERE
			ad_client_id = $P{AD_CLIENT_ID}
		LIMIT 1
	) l
		ON oi.c_location_id = l.c_location_id
WHERE
	cl.ad_client_id = $P{AD_CLIENT_ID}
	AND u.ad_user_id = $P{AD_USER_ID}
GROUP BY
	cl.name, u.name,
	COALESCE(
		l.address1, ''),
	COALESCE(
		l.address2, '');]]>
	</queryString>
