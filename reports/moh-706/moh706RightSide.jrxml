	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	COALESCE(oi.bh_affiliation, '')                                                                                      AS affiliation,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '307')                            AS tb_smear_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '307' AND
		                           ed.bh_value IN ('Positive', 'One plus', 'Two plus', 'Three plus',
		                                           'Scanty') )                                                             AS tb_smear_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '299')                            AS vdrl_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '299' AND ed.bh_value =
		                                                                                                       'Reactive') AS vdrl_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '1032')                           AS tpha_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '1032' AND
		                           ed.bh_value =
		                           'Reactive')                                                                             AS tpha_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '161469')                         AS asot_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '161469' AND
		                           ed.bh_value::NUMERIC >
		                           200)                                                                                    AS asot_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '163722')                         AS hiv_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '163722' AND
		                           ed.bh_value =
		                           'Positive')                                                                             AS hiv_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '305')                            AS brucella_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '305' AND ed.bh_value =
		                                                                                                       'Reactive') AS brucella_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '161470')                         AS rheumatoid_factor_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '161470' AND
		                           ed.bh_value =
		                           'Positive')                                                                             AS rheumatoid_factor_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '163620')                         AS hpylori_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '163620' AND
		                           ed.bh_value =
		                           'Positive')                                                                             AS hpylori_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'LOINC' AND c.bh_oclid IN ('20575-7', '32018-4',
		                                                                                    '22314-9'))                    AS hepatitisa_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'LOINC' AND
		                           c.bh_oclid IN ('20575-7', '32018-4', '22314-9') AND ed.bh_value NOT ILIKE
		                                                                               '%neg%')                            AS hepatitisa_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid IN ('159430', '161472',
		                                                                                               '165301'))          AS hepatitisb_total,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid IN ('159430', '161472', '165301') AND
		               LOWER(ed.bh_value) =
		               'positive')                                                                                         AS hepatitisb_positive,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid IN ('1325', '161471',
		                                                                                               '165302'))          AS hepatitisc_total,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid IN ('1325', '161471', '165302') AND
		               LOWER(ed.bh_value) =
		               'positive')                                                                                         AS hepatitisc_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '1945')                           AS hcg_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '1945' AND
		                           ed.bh_value =
		                           'Positive')                                                                             AS hcg_positive,
		COUNT(ed.*)
		FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '166555')                         AS crag_test_total,
		COUNT(ed.*) FILTER ( WHERE ed.bh_value IS NOT NULL AND c.bh_source = 'CIEL' AND c.bh_oclid = '166555' AND
		                           ed.bh_value =
		                           'Positive')                                                                             AS crag_test_positive

FROM
	ad_orginfo oi
		LEFT JOIN bh_visit v
		ON oi.ad_client_id = v.ad_client_id AND v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
		LEFT JOIN bh_encounter e
		ON v.bh_visit_id = e.bh_visit_id
		LEFT JOIN bh_encounter_diagnostic ed
		ON e.bh_encounter_id = ed.bh_encounter_id
		LEFT JOIN bh_concept c
		ON ed.bh_concept_id = c.bh_concept_id
		LEFT JOIN c_bpartner patient
		ON patient.c_bpartner_id = v.patient_id
WHERE
	oi.ad_client_id = $P{AD_CLIENT_ID}
GROUP BY
	oi.bh_affiliation;]]>
	</queryString>
