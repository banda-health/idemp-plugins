	<subDataset name="ProductsDataSet" uuid="c3eec118-51b1-4edd-9dee-c29770378c9d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
		<parameter name="BH_Visit_UU" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
	p.name        AS Product,
	ol.created    AS created,
	ol.description,
	ol.qtyordered AS qty
FROM
	bh_visit v
		JOIN c_order o
		ON v.bh_visit_id = o.bh_visit_id
		JOIN c_orderline ol
		ON o.c_order_id = ol.c_order_id
		JOIN m_product p
		ON ol.m_product_id = p.m_product_id
		JOIN m_product_category pc
		ON p.m_product_category_id = pc.m_product_category_id AND pc.name = 'Pharmacy'
WHERE
	issotrx = 'Y'
	AND v.bh_visit_uu = $P{BH_Visit_UU}]]>
		</queryString>
		<field name="product" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="product"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="m_product"/>
		</field>
		<field name="description" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="charge"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="c_orderline"/>
		</field>
		<field name="created" class="java.sql.Timestamp"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<group name="product">
			<groupExpression><![CDATA[$F{product}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="InsurerSpecificFields" uuid="143228f5-5dd5-49c5-85c1-3c4b94f3b367">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="iDempiere Docker PostgreSQL"/>
		<parameter name="Ins_BH_Visit_UU" class="java.lang.String"/>
		<parameter name="Ins_BPartner_UU" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
	pif.line,
	pif.name   AS field_name,
	bpspi.name AS field_value
FROM
	bh_visit v
		JOIN c_invoice i
		ON v.bh_visit_id = i.bh_visit_id
		JOIN c_invoiceline il
		ON i.c_invoice_id = il.c_invoice_id
		JOIN bh_bp_specific_payer_info bpspi
		ON il.c_invoiceline_id = bpspi.c_invoiceline_id
		JOIN bh_payer_info_fld pif
		ON pif.bh_payer_info_fld_id = bpspi.bh_payer_info_fld_id
		JOIN c_bpartner bp
		ON pif.bh_payer_id = bp.c_bpartner_id
WHERE
	v.bh_visit_uu = $P{Ins_BH_Visit_UU}
	AND bp.c_bpartner_uu = COALESCE($P{Ins_BPartner_UU}, '')
ORDER BY
	pif.line
LIMIT 5]]>
		</queryString>
		<field name="line" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="line"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_payer_info_fld"/>
		</field>
		<field name="field_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="field_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_payer_info_fld"/>
		</field>
		<field name="field_value" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="field_value"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_bp_specific_payer_info"/>
		</field>
	</subDataset>
	<subDataset name="DiagnosisDataSet" uuid="4c1cc20c-c5ac-4c83-9676-e7edce346c1e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
		<parameter name="BH_Visit_UU" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
	COALESCE(cd.bh_display_name, ed.bh_uncoded_diagnosis) AS diagnosis,
	ed.created
FROM
	bh_visit v
		JOIN bh_encounter e
		ON e.bh_visit_id = v.bh_visit_id
		JOIN bh_encounter_diagnosis ed
		ON e.bh_encounter_id = ed.bh_encounter_id
		LEFT JOIN bh_concept cd
		ON ed.bh_concept_id = cd.bh_concept_id
WHERE
	v.bh_visit_uu = $P{BH_Visit_UU}
ORDER BY
	ed.lineno]]>
		</queryString>
		<field name="diagnosis" class="java.lang.String"/>
		<field name="created" class="java.sql.Timestamp"/>
	</subDataset>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<parameter name="ShowInsuranceInfo" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH visit AS (
	SELECT
		v.bh_visit_id,
		v.bh_visitdate,
		v.patient_id,
		v.documentno,
		v.ad_org_id,
		o.updated AS end_date,
		v.bh_clinician_user_id
	FROM
		bh_visit v
			JOIN c_order o
			ON v.bh_visit_id = o.bh_visit_id
	WHERE
		v.bh_visit_uu = $P{BH_Visit_UU}
),
	payment_summary AS (
		SELECT
			bh_visit_id,
			STRING_AGG(payment_type, ', ') AS payment_type,
			SUM(payamt)                    AS payment_amount
		FROM
			(
				SELECT
					v.bh_visit_id,
					rl.name       AS payment_type,
					SUM(p.payamt) AS payamt
				FROM
					visit v
						JOIN c_payment p
						ON p.bh_visit_id = v.bh_visit_id
						JOIN ad_ref_list rl
						ON p.tendertype = rl.value AND rl.ad_reference_id = 214
				GROUP BY v.bh_visit_id, rl.name
				UNION ALL
				SELECT
					v.bh_visit_id,
					c.name AS payment_type,
					0      AS payamt
				FROM
					visit v
						JOIN c_order o
						ON v.bh_visit_id = o.bh_visit_id
						JOIN c_orderline ol
						ON o.c_order_id = ol.c_order_id
						JOIN c_charge c
						ON c.c_charge_id = ol.c_charge_id
			) p
		GROUP BY bh_visit_id
	),
	-- If running for insurance, produce one row for each insurer. If for patient, produce 1 row for patient
	payer AS (
		SELECT
			v.bh_visit_id,
			bpins.c_bpartner_id AS insurer_id,
			bpins.c_bpartner_uu AS insurer_uu,
			bpins.name          AS insurer_name,
			i.documentno        AS invoice_id,
			i.grandtotal        AS invoice_amount
		FROM
			visit v
				JOIN c_invoice i
				ON v.bh_visit_id = i.bh_visit_id
				JOIN c_bpartner bpins
				ON i.c_bpartner_id = bpins.c_bpartner_id
				JOIN c_bp_group bpg
				ON bpins.c_bp_group_id = bpg.c_bp_group_id
		WHERE
			i.docstatus = 'CO'
			AND (($P{ShowInsuranceInfo} AND COALESCE(bpg.bh_subtype, '') IN ('I', 'D'))
				OR (NOT $P{ShowInsuranceInfo} AND COALESCE(bpg.bh_subtype, '') NOT IN ('I', 'D'))
				)
	)
SELECT
	v.bh_visitdate                    AS date,
	v.end_date                        AS end_date,
	v.documentno                      AS visit_number,
	bp.name                           AS patient,
	bp.bh_gender                      AS gender,
	bp.bh_patientid                   AS patient_id,
	u.name                            AS served_by,
	o.grandtotal                      AS order_total,
	p.invoice_id,
	p.invoice_amount,
	COALESCE(ps.payment_type, 'None') AS payment_type,
	ps.payment_amount,
	oi.bh_paymentinformation,
	p.insurer_id,
	p.insurer_uu,
	p.insurer_name,
	clinician.name 						AS clinician
FROM
	visit v
		JOIN c_order o
		ON v.bh_visit_id = o.bh_visit_id
		JOIN c_bpartner bp
		ON v.patient_id = bp.c_bpartner_id
		LEFT JOIN ad_user u
		ON o.salesrep_id = u.ad_user_id
		LEFT JOIN payment_summary ps
		ON ps.bh_visit_id = v.bh_visit_id
		LEFT JOIN ad_orginfo oi
		ON v.ad_org_id = oi.ad_org_id
		LEFT JOIN payer p
		ON p.bh_visit_id = v.bh_visit_id
		LEFT JOIN ad_user clinician
		ON v.bh_clinician_user_id = clinician.ad_user_id]]>
	</queryString>
	<field name="date" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.label" value="date"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="bh_visit"/>
	</field>
	<field name="patient" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="patient"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="gender" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="gender"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="patient_id" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="patient_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="served_by" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="served_by"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
	</field>
	<field name="order_total" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="order_total"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_order"/>
	</field>
	<field name="invoice_id" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="invoice_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_invoice"/>
	</field>
	<field name="invoice_amount" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="invoice_amount"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_invoice"/>
	</field>
	<field name="payment_type" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="payment_type"/>
	</field>
	<field name="payment_amount" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="payment_amount"/>
	</field>
	<field name="bh_paymentinformation" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="bh_paymentinformation"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_orginfo"/>
	</field>
	<field name="insurer_id" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="insurer_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="insurer_uu" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="insurer_uu"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="insurer_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="insurer_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="c_bpartner"/>
	</field>
	<field name="visit_number" class="java.lang.String"/>
	<field name="end_date" class="java.sql.Timestamp"/>
	<field name="clinician" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="clinician"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
	</field>
	<variable name="Total" class="java.math.BigDecimal" calculation="Sum"/>
	<variable name="OpenBalance" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$P{ShowInsuranceInfo} ? new BigDecimal(0) : ($F{invoice_amount} == null) ? new BigDecimal(0) : $F{invoice_amount}.subtract($F{payment_amount} != null ? $F{payment_amount} : new BigDecimal(0))]]></variableExpression>
	</variable>
	<group name="Insurer" isStartNewPage="true" isResetPageNumber="true">
		<groupExpression><![CDATA[$F{insurer_uu}]]></groupExpression>
	</group>
