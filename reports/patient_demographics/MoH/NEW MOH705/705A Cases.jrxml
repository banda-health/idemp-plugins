	<subDataset name="MOH_A Dataset" uuid="3b0d1345-0360-41e5-97ee-180a3cc3fe01">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
		<parameter name="Begin Date" class="java.sql.Timestamp"/>
		<parameter name="End Date" class="java.sql.Timestamp"/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[WITH date_limitter AS (
	SELECT
		GENERATE_SERIES(date($P{Begin Date}), date($P{End Date}), '1d')::date AS calendar
),
	diagnosis_list AS (
		SELECT DISTINCT
			bh_moh705a_lessthan5 AS diagnosis
		FROM
			bh_coded_diagnosis
		WHERE
				bh_moh705a_lessthan5 NOT IN ('NA', 'COVID-19 - suspected', 'COVID-19 - confirmed', 'Overweight (BMI>25)',
				                             'Other Diseases Of Respiratory System', 'Tuberculosis',
				                             'Sexually Transmitted Infections', 'Fevers',
				                             'Chromosomal Abnormalities (E.G Downs Syndrome; Edwards Syndrome Etc.)',
				                             'Upper Respiratory Infection', 'Other Eye Conditions', 'Plague',
				                             'Arthritis; Joint pains; etc', 'Diarrhea', 'Kalaazar', 'Congenital Anomalies',
				                             'Ear infections / conditions', 'Newly Diagnosed HIV', 'Tetanus (not neonatal)',
				                             'Sexual Assault', 'Dracunculiasis (Guinea Worm)', 'Neoplasms',
				                             'Physical Disability', 'Cardiovascular Conditions', 'Musculoskeletal Conditions',
				                             'Other Central Nervous System Conditions')

	),
	visit_diagnoses AS (
		SELECT
			v.bh_visit_id,
			ev.bh_coded_diagnosis_id,
			ev.bh_uncoded_diagnosis,
			ROW_NUMBER() OVER (PARTITION BY v.bh_visit_id ORDER BY lineno) AS diagnosis_rank
		FROM
			bh_visit v
				JOIN bh_encounter e
				ON v.bh_visit_id = e.bh_visit_id
				LEFT JOIN bh_encounter_diagnosis ev
				ON e.bh_encounter_id = ev.bh_encounter_id
		WHERE
				v.bh_visit_id IN (
				SELECT bh_visit_id FROM c_order WHERE docstatus IN ('CO', 'CL') AND ad_client_id = $P{AD_CLIENT_ID}
			)
	),
	diagnosis_count AS (
		SELECT DISTINCT
			b.bh_moh705a_lessthan5       AS diagnosis,
			c.calendar,
			COALESCE(c.noofdiagnosis, 0) AS noofdiagnosis
		FROM
			bh_coded_diagnosis b
				LEFT JOIN (
				SELECT
					bh_moh705a_lessthan5,
					CAST(bh_visitdate AS date)      AS calendar,
					COUNT(pd.bh_coded_diagnosis_id) AS noofdiagnosis
				FROM
					bh_visit v
						JOIN visit_diagnoses pd
						ON pd.bh_visit_id = v.bh_visit_id AND pd.diagnosis_rank = 1
						JOIN bh_coded_diagnosis cd
						ON pd.bh_coded_diagnosis_id = cd.bh_coded_diagnosis_id
						JOIN date_limitter dl
						ON dl.calendar = CAST(bh_visitdate AS date)
						JOIN c_bpartner bp
						ON v.patient_id = bp.c_bpartner_id
				WHERE
					bp.bh_birthday IS NOT NULL
					AND DATE_PART('year', AGE(bp.bh_birthday)) < 5
					AND v.bh_patienttype != 'Im'
				GROUP BY bh_moh705a_lessthan5, CAST(bh_visitdate AS date)
			) c
				ON b.bh_moh705a_lessthan5 = c.bh_moh705a_lessthan5
	)
SELECT
	dl.diagnosis,
	dali.calendar,
	COALESCE(dc.noofdiagnosis, 0) AS noofdiagnosis
-- c.calendar
FROM
	diagnosis_list dl
		CROSS JOIN date_limitter dali
		LEFT JOIN diagnosis_count dc
		ON dc.calendar = dali.calendar
		AND dl.diagnosis = dc.diagnosis
		JOIN (
		VALUES
			('Diarrhea with no dehydration', 10),
			('Diarrhea with some dehydration', 20),
			('Diarrhea with severe dehydration', 30),
			('Cholera', 40),
			('Dysentery (Bloody Diarrhea)', 50),
			('Gastroenteritis', 60),
			('Pneumonia', 70),
			('Severe pneumonia', 80),
			('Upper Respiratory Tract Infections', 90),
			('Lower Respiratory Tract Infection', 100),
			('Asthma', 110),
			('Presumed Tuberculosis', 120),
			('Suspected Malaria', 130),
			('Tested for malaria', 140),
			('Confirmed Malaria (Only Positive Cases)', 150),
			('Ear infections', 160),
			('Malnutrition', 170),
			('Anemia', 180),
			('Meningococcal Meningitis', 190),
			('Other Meningitis', 200),
			('Neonatal Sepsis', 210),
			('Neonatal Tetanus', 220),
			('Poliomyelitis (AFP)', 230),
			('Chickenpox', 240),
			('Measles', 250),
			('Hepatitis', 260),
			('Amoebiasis', 270),
			('Mumps', 280),
			('Typhoid Fever', 290),
			('Bilharzia', 300),
			('Intestinal Worms', 310),
			('Eye Infections', 320),
			('Tonsillitis', 330),
			('Urinary Tract Infection', 340),
			('Mental Disorders', 350),
			('Dental Disorders', 360),
			('Jiggers Infestation', 370),
			('Diseases Of The Skin', 380),
			('Downs Syndrome', 390),
			('Poisoning', 400),
			('Road Traffic Injuries', 410),
			('Deaths Due To Road Traffic Injuries', 420),
			('Violence Related Injuries', 430),
			('Other Injuries', 440),
			('Sexual violence', 450),
			('Burns', 460),
			('Snakebites', 470),
			('Dog Bites', 480),
			('Other Bites', 490),
			('Diabetes', 500),
			('Epilepsy', 510),
			('Other Convulsive Disorders', 520),
			('Rheumatic Fever', 530),
			('Brucellosis', 540),
			('Rickets', 550),
			('Cerebral Palsy', 560),
			('Autism', 570),
			('Trypanosomiasis', 580),
			('Yellow Fever', 590),
			('Viral Hemorrhagic Fever', 600),
			('Rift Valley Fever', 610),
			('Chikugunya', 620),
			('Dengue Fever', 630),
			('Leishmaniasis (Kalaazar)', 640),
			('Cutaneous leishmaniasis', 650),
			('Suspected Anthrax', 660),
			('Suspected Childhood Cancer', 670),
			('Hypoxemia (Sat <90%)', 680),
			('All Other Diseases', 690)
	) dlo (diagnosis, "order")
		ON dl.diagnosis = dlo.diagnosis
ORDER BY
	dlo."order", dali.calendar]]>
		</queryString>
		<field name="calendar" class="java.sql.Date">
			<property name="com.jaspersoft.studio.field.label" value="calendar"/>
		</field>
		<field name="diagnosis" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="diagnosis"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_coded_diagnosis"/>
		</field>
		<field name="noofdiagnosis" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="noofdiagnosis"/>
		</field>
		<group name="calendar">
			<groupExpression><![CDATA[$F{calendar}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[WITH visit_diagnoses AS (
	SELECT
		v.bh_visit_id,
		ev.bh_coded_diagnosis_id,
		ev.bh_uncoded_diagnosis,
		ROW_NUMBER() OVER (PARTITION BY v.bh_visit_id ORDER BY lineno) AS diagnosis_rank
	FROM
		bh_visit v
			JOIN bh_encounter e
			ON v.bh_visit_id = e.bh_visit_id
			LEFT JOIN bh_encounter_diagnosis ev
			ON e.bh_encounter_id = ev.bh_encounter_id
)
SELECT
	date(v.bh_visitdate) AS calendar,
	o.name               AS name
FROM
	bh_visit v
		LEFT JOIN visit_diagnoses pd
		ON v.bh_visit_id = pd.bh_visit_id AND pd.diagnosis_rank = 1
		LEFT JOIN bh_coded_diagnosis cd
		ON cd.bh_coded_diagnosis_id = pd.bh_coded_diagnosis_id
		RIGHT JOIN ad_org o
		ON v.ad_client_id = o.ad_client_id
		AND o.isactive = 'Y'
WHERE
	v.ad_client_id = $P{AD_CLIENT_ID}
GROUP BY
	v.bh_visitdate, o.name, cd.bh_moh705a_lessthan5]]>
	</queryString>
	<field name="calendar" class="java.sql.Date"/>
	<field name="name" class="java.lang.String"/>
