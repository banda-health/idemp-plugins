			<style forecolor="#FF0000"/>
		</conditionalStyle>
	</style>
	<parameter name="Group1" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	COALESCE(pce.bh_value, panel.bh_display_name) AS panel,
	COALESCE(tce.bh_value, test.bh_display_name)      AS name,
	ed.bh_value                                   AS result,
	test_ref_range.reference_range                AS range,
	test_ref_range.status
FROM
	bh_encounter_diagnostic ed
		LEFT JOIN bh_concept panel
		ON ed.selected_panel_id = panel.bh_concept_id
		LEFT JOIN bh_concept_extra pce
		ON panel.bh_concept_id = pce.bh_concept_id AND pce.bh_key = 'local_name'
		JOIN bh_concept test
		ON ed.bh_concept_id = test.bh_concept_id
		LEFT JOIN bh_concept_extra tce
		ON test.bh_concept_id = tce.bh_concept_id AND tce.bh_key = 'local_name'
		LEFT JOIN (
		SELECT
			STRING_AGG(
				CASE
					WHEN bce.bh_key = 'low_normal' THEN CONCAT(bce.bh_value, ' - ')
					WHEN bce.bh_key = 'hi_normal' THEN bce.bh_value
					WHEN bce.bh_key = 'units' THEN bce.bh_value
					END, ' '
				ORDER BY
					CASE
						WHEN bce.bh_key = 'low_normal' THEN 1
						WHEN bce.bh_key = 'hi_normal' THEN 2
						WHEN bce.bh_key = 'units' THEN 3
						END
			) AS reference_range,
			STRING_AGG(
				CASE
					WHEN bce.bh_key = 'low_normal' AND EXISTS (
						SELECT
							1
						FROM
							bh_concept_extra bce_sub
						WHERE
							bce_sub.bh_concept_id = bce.bh_concept_id
							AND bce_sub.bh_key = 'hi_normal'
							AND CAST(bed.bh_value AS FLOAT) BETWEEN CAST(bce.bh_value AS FLOAT) AND CAST(bce_sub.bh_value AS FLOAT)
					) THEN 'Normal'
					WHEN bce.bh_key = 'hi_normal' AND CAST(bed.bh_value AS FLOAT) > CAST(bce.bh_value AS FLOAT) THEN 'High'
					WHEN bce.bh_key = 'low_normal' AND CAST(bed.bh_value AS FLOAT) < CAST(bce.bh_value AS FLOAT) THEN 'Low'
					END, ''
			) AS status,
			c.bh_concept_id
		FROM
			bh_concept c
				JOIN bh_concept_extra bce
				ON c.bh_concept_id = bce.bh_concept_id AND bce.bh_key != 'local_name'
				JOIN bh_encounter_diagnostic bed
				ON c.bh_concept_id = bed.bh_concept_id
		WHERE
			bed.group1 = $P{Group1}
		GROUP BY c.bh_concept_id
	) AS test_ref_range
		ON test_ref_range.bh_concept_id = test.bh_concept_id
WHERE
	group1 = $P{Group1}
	AND ed.bh_value IS NOT NULL
ORDER BY
	ed.lineno]]>
	</queryString>
