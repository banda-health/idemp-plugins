	<subDataset name="LabDataSet" uuid="c3eec118-51b1-4edd-9dee-c29770378c9d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDB Adapter"/>
		<parameter name="BH_Visit_UU" class="java.lang.String"/>
		<parameter name="PanelName" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[select
    bed.created as date,
    coalesce(test_name.name, test.bh_display_name) as name,
    bed.bh_value as result,
    test_ref_range.reference_range as range,
    test_ref_range.status,
    coalesce(panel.name, '') as panel_name
from bh_encounter_diagnostic bed
join bh_encounter be on bed.bh_encounter_id = be.bh_encounter_id
join bh_visit bv on be.bh_visit_id = bv.bh_visit_id
join bh_concept test on bed.bh_concept_id = test.bh_concept_id
left join bh_concept_extra tbce on test.bh_concept_id = tbce.bh_concept_id and tbce.bh_key = 'local_name'
left join (
    select
        coalesce(pbce.bh_value, p.bh_display_name) as name,
        c.bh_concept_id
    from bh_concept c
    join bh_concept_mapping bcm on bcm.to_bh_concept_id = c.bh_concept_id
    join bh_concept p on bcm.from_bh_concept_id = p.bh_concept_id and p.bh_concept_class = 'LabSet'
    join bh_concept_extra pbce on p.bh_concept_id = pbce.bh_concept_id and pbce.bh_key = 'local_name'
    group by c.bh_concept_id, coalesce(pbce.bh_value, p.bh_display_name)
) as panel on panel.bh_concept_id = test.bh_concept_id
left join (
    select
        string_agg(
                CASE
                   WHEN bce.bh_key = 'low_normal' THEN concat(bce.bh_value, ' - ')
                   WHEN bce.bh_key = 'hi_normal' THEN bce.bh_value
                   WHEN bce.bh_key = 'units' THEN bce.bh_value
                END, ' '
                ORDER BY
                CASE
                    WHEN bce.bh_key = 'low_normal' THEN 1
                    WHEN bce.bh_key = 'hi_normal' THEN 2
                    WHEN bce.bh_key = 'units' THEN 3
                END
                ) AS reference_range,
        string_agg(
        		CASE
		            WHEN bce.bh_key = 'low_normal' AND EXISTS (
		                SELECT 1
		                FROM bh_concept_extra bce_sub
		                WHERE bce_sub.bh_concept_id = bce.bh_concept_id
		                AND bce_sub.bh_key = 'hi_normal'
		                AND CAST(bed.bh_value AS FLOAT) BETWEEN CAST(bce.bh_value AS FLOAT) AND CAST(bce_sub.bh_value AS FLOAT)
		            ) THEN 'Normal'
		            WHEN bce.bh_key = 'hi_normal' AND CAST(bed.bh_value AS FLOAT) > CAST(bce.bh_value AS FLOAT) THEN 'High'
		            WHEN bce.bh_key = 'low_normal' AND CAST(bed.bh_value AS FLOAT) < CAST(bce.bh_value AS FLOAT) THEN 'Low'
		        END, ''
	    ) AS status,        
        c.bh_concept_id,
        bv.bh_visit_uu
    from bh_concept c
    join bh_concept_extra bce on c.bh_concept_id = bce.bh_concept_id and bce.bh_key != 'local_name'
    join bh_encounter_diagnostic bed on c.bh_concept_id = bed.bh_concept_id
    join bh_encounter be on bed.bh_encounter_id = be.bh_encounter_id
    join bh_visit bv on be.bh_visit_id = bv.bh_visit_id
    group by c.bh_concept_id, bv.bh_visit_uu
) as test_ref_range on test_ref_range.bh_concept_id = test.bh_concept_id
left join (
    select
        coalesce(bce.bh_value, bmce.bh_value, c.bh_display_name) as name,
        c.bh_concept_id
    from bh_concept c
    join bh_concept_mapping bcm on c.bh_concept_id = bcm.to_bh_concept_id
    join bh_concept_extra bmce on bcm.bh_concept_mapping_id = bmce.bh_concept_mapping_id and bmce.bh_key = 'local_name'
    left join bh_concept_extra bce on c.bh_concept_id = bce.bh_concept_id and bce.bh_key = 'local_name'
    group by c.bh_concept_id, coalesce(bce.bh_value, bmce.bh_value, c.bh_display_name)
) as test_name on test_name.bh_concept_id = test.bh_concept_id
where bed.bh_value is not null and bv.bh_visit_uu = $P{BH_Visit_UU}
and (CASE WHEN test_ref_range.bh_visit_uu IS NOT NULL THEN test_ref_range.bh_visit_uu = $P{BH_Visit_UU} ELSE true END) 
and (CASE WHEN panel.name IS NOT NULL THEN panel.name ELSE 'Test' END) = $P{PanelName}]]>
		</queryString>
		<field name="name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="test_name"/>
		</field>
		<field name="result" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="result"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_encounter_diagnostic"/>
		</field>
		<field name="status" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="status"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="bh_encounter_diagnostic"/>
		</field>
		<field name="range" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="range"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="test_ref_range"/>
		</field>
		<field name="date" class="java.sql.Timestamp"/>
		<field name="panel_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="panel_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="panel"/>
		</field>
		<group name="panel_name" isStartNewPage="true" isResetPageNumber="true">
			<groupExpression><![CDATA[$F{panel_name}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<parameter name="PanelName" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
    DISTINCT 
    CASE
        WHEN panel.name IS NOT NULL THEN panel.name
        ELSE 'Test'
    END AS panel_name
from bh_encounter_diagnostic bed
join bh_encounter be on bed.bh_encounter_id = be.bh_encounter_id
join bh_visit bv on be.bh_visit_id = bv.bh_visit_id
join bh_concept test on bed.bh_concept_id = test.bh_concept_id
left join bh_concept_extra tbce on test.bh_concept_id = tbce.bh_concept_id and tbce.bh_key = 'local_name'
left join (
    select
        coalesce(pbce.bh_value, p.bh_display_name) as name,
        c.bh_concept_id
    from bh_concept c
    join bh_concept_mapping bcm on bcm.to_bh_concept_id = c.bh_concept_id
    join bh_concept p on bcm.from_bh_concept_id = p.bh_concept_id and p.bh_concept_class = 'LabSet'
    join bh_concept_extra pbce on p.bh_concept_id = pbce.bh_concept_id and pbce.bh_key = 'local_name'
    group by c.bh_concept_id, coalesce(pbce.bh_value, p.bh_display_name)
) as panel on panel.bh_concept_id = test.bh_concept_id
where bv.bh_visit_uu = $P{BH_Visit_UU} and (CASE WHEN panel.name IS NOT NULL THEN panel.name ELSE 'Test' END) = $P{PanelName}]]>
	</queryString>
	<field name="panel_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="panel_name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="panel"/>
	</field>
