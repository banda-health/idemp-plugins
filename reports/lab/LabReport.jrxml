	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	DISTINCT 
		case when panel.name is not null then panel.name 
     	else 'Test' end				  AS panel_name,
	v.bh_visitdate                    AS date,
	v.documentno                      AS visit_number,
	bp.name                           AS patient,
	bp.bh_gender                      AS gender,
	bp.bh_patientid                   AS patient_id,
	u.name                            AS served_by,
	clinician.name 					  AS clinician
FROM
	bh_visit v
		JOIN bh_encounter be 
		ON v.bh_visit_id = be.bh_visit_id
		JOIN bh_encounter_diagnostic bed
		ON be.bh_encounter_id = bed.bh_encounter_id
		JOIN bh_concept test 
		on bed.bh_concept_id = test.bh_concept_id
		LEFT JOIN  (
		    select
		        coalesce(pbce.bh_value, p.bh_display_name) as name,
		        c.bh_concept_id
		    from bh_concept c
		    join bh_concept_mapping bcm on bcm.to_bh_concept_id = c.bh_concept_id
		    join bh_concept p on bcm.from_bh_concept_id = p.bh_concept_id and p.bh_concept_class = 'LabSet'
		    join bh_concept_extra pbce on p.bh_concept_id = pbce.bh_concept_id and pbce.bh_key = 'local_name'
		    group by c.bh_concept_id, coalesce(pbce.bh_value, p.bh_display_name)
		) as panel on panel.bh_concept_id = test.bh_concept_id
		JOIN c_order o
		ON v.bh_visit_id = o.bh_visit_id
		JOIN c_bpartner bp
		ON v.patient_id = bp.c_bpartner_id
		LEFT JOIN ad_user u
		ON o.salesrep_id = u.ad_user_id
		LEFT JOIN ad_orginfo oi
		ON v.ad_org_id = oi.ad_org_id
		LEFT JOIN ad_user clinician
		ON v.bh_clinician_user_id = clinician.ad_user_id
		where v.bh_visit_uu = $P{BH_Visit_UU}]]>
	</queryString>
