	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="C_Charge_UU" class="java.lang.String"/>
	<parameter name="C_BPartner_UU" class="java.lang.String"/>
	<parameter name="Payment Method" class="java.lang.String"/>
	<parameter name="Created By" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	TO_CHAR(i.dateinvoiced::date, 'YYYY-MM-DD') AS expense_date,
	c.name                                      AS expense_category,
	bp.name                                     AS supplier_name,
	u.name                                      AS tracked_by,
	rl.name                                     AS payment_method,
	il.linenetamt                               AS amount
FROM
	c_invoice i
		JOIN c_invoiceline il
		ON i.c_invoice_id = il.c_invoice_id
		JOIN c_charge c
		ON il.c_charge_id = c.c_charge_id
		JOIN c_chargetype ct
		ON c.c_chargetype_id = ct.c_chargetype_id AND ct.name = 'Default Expense Category - DO NOT CHANGE'
		JOIN c_bpartner bp
		ON i.c_bpartner_id = bp.c_bpartner_id
		JOIN ad_user u
		ON i.createdby = u.ad_user_id
		JOIN ad_ref_list rl
		ON i.paymentrule = rl.value
		JOIN ad_reference r
		ON rl.ad_reference_id = r.ad_reference_id AND r.ad_reference_uu = 'af0136e2-1ec4-4b60-a8a1-dc6c252e4878'
WHERE
	i.issotrx = 'N'
	AND i.c_order_id IS NULL
	AND i.bh_visit_id IS NULL
	AND i.docstatus IN ('CO', 'CL')
	AND i.ad_client_id = $P{AD_CLIENT_ID}
	AND i.dateinvoiced::date + i.updated::time BETWEEN $P{Begin Date} AND $P{End Date}
	AND ($P{C_Charge_UU} IS NULL OR c.c_charge_uu = $P{C_Charge_UU})
	AND ($P{C_BPartner_UU} IS NULL OR bp.c_bpartner_uu = $P{C_BPartner_UU})
	AND (COALESCE($P{Payment Method}, '') = '' OR $P{Payment Method} = i.paymentrule)
	AND (COALESCE($P{Created By}, '') = '' OR $P{Created By} = u.ad_user_uu)]]>
	</queryString>
