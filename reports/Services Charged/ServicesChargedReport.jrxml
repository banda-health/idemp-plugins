	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Patient Tags" class="java.util.List"/>
	<queryString>
		<![CDATA[SELECT
	p.item_name               AS item_name,
	SUM(billdetails.quantity) AS quantity,
	billdetails.saleprice     AS sellingprice,
	SUM(billdetails.amount)   AS amount,
	product_category
FROM
	(
		SELECT
			p.m_product_id,
			p.name  AS item_name,
			pc.name AS product_category
		FROM
			m_product p
				JOIN m_product_category pc
				ON p.m_product_category_id = pc.m_product_category_id
		WHERE
			p.ad_client_id = $P{AD_CLIENT_ID}
			AND p.isactive = 'Y'
			AND p.producttype = 'S'
	) AS p
		JOIN (
		SELECT
			ol.m_product_id,
			ol.qtyordered   AS quantity,
			ol.priceentered AS saleprice,
			ol.linenetamt   AS amount
		FROM
			c_orderline ol
				JOIN c_order o
				ON ol.c_order_id = o.c_order_id
				JOIN bh_visit v
				ON o.bh_visit_id = v.bh_visit_id
				JOIN c_bpartner bp
				ON o.c_bpartner_id = bp.c_bpartner_id
				JOIN m_product p
				ON ol.m_product_id = p.m_product_id
				AND p.producttype = 'S'
		WHERE
			ol.ad_client_id = $P{AD_CLIENT_ID}
			AND ol.processed = 'Y'
			AND v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
			AND (
				$X{IN, bp.c_bpartner_uu, Patient Tags} OR
				bp.c_bpartner_id IN (
					SELECT
						c_bpartner_id
					FROM
						bh_bpartner_tags
					WHERE
						bh_tag_id IN (
							SELECT
								bh_tag_id
							FROM
								bh_tag
							WHERE
								$X{IN, bh_tag_uu, Patient Tags}
						)
				)
				)
	) AS billdetails
		ON p.m_product_id = billdetails.m_product_id
GROUP BY
	p.item_name, billdetails.saleprice, product_category
ORDER BY
	product_category, p.item_name]]>
	</queryString>
