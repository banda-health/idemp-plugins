	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	m.movementdate,
	u.name      AS user_name,
	p.name      AS product_name,
	asi.guaranteedate,
	gpc.purchase_date,
	gpc.purchase_price,
	ml.qtyentered,
	from_w.name AS from_warehouse,
	to_w.name   AS to_warehouse
FROM
	m_movement m
		JOIN m_movementline ml
		ON m.m_movement_id = ml.m_movement_id
		JOIN ad_user u
		ON m.createdby = u.ad_user_id
		JOIN m_product p
		ON ml.m_product_id = p.m_product_id
		JOIN m_attributesetinstance asi
		ON ml.m_attributesetinstance_id = asi.m_attributesetinstance_id
		JOIN get_product_costs($P{AD_CLIENT_ID}) gpc
		ON p.m_product_id = gpc.m_product_id AND asi.m_attributesetinstance_id = gpc.m_attributesetinstance_id
		JOIN m_locator to_l
		ON ml.m_locatorto_id = to_l.m_locator_id
		JOIN m_warehouse to_w
		ON to_l.m_warehouse_id = to_w.m_warehouse_id
		JOIN m_locator from_l
		ON ml.m_locator_id = from_l.m_locator_id
		JOIN m_warehouse from_w
		ON from_l.m_warehouse_id = from_w.m_warehouse_id
WHERE
	m.ad_client_id = $P{AD_CLIENT_ID}
	AND m.movementdate BETWEEN $P{Begin Date} AND $P{End Date}
ORDER BY
	movementdate, p.name, u.name, to_w.name, from_w.name;]]>
	</queryString>
