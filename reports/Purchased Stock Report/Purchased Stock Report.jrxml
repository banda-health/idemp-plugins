	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="C_BPartner_UU" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	c.name           AS client_name,
	inv.dateinvoiced,
	inv.vendor_name,
	inv.total_bill,
	inv.amount_paid,
	inv.balance_due,
	inv.received_by
FROM
	ad_client c
		LEFT JOIN (
			SELECT
				i.ad_client_id,
				i.dateinvoiced,
				bp.name                                                       AS vendor_name,
				i.grandtotal                                                  AS total_bill,
				i.grandtotal - COALESCE(invoiceopen(i.c_invoice_id, NULL), 0) AS amount_paid,
				COALESCE(invoiceopen(i.c_invoice_id, NULL), 0)                AS balance_due,
				string_agg(DISTINCT u.name, ', ')                             AS received_by
			FROM
				c_invoice i
					JOIN c_bpartner bp ON i.c_bpartner_id = bp.c_bpartner_id
					JOIN c_order o     ON i.c_order_id = o.c_order_id
					JOIN m_inout io    ON io.c_order_id = o.c_order_id AND io.issotrx = 'N' AND io.docstatus IN ('CO', 'CL')
					LEFT JOIN ad_user u ON io.createdby = u.ad_user_id
			WHERE
				i.issotrx = 'N'
				AND i.docstatus IN ('CO', 'CL')
				AND i.bh_visit_id IS NULL
				AND i.dateinvoiced BETWEEN $P{Begin Date} AND $P{End Date}
				AND (COALESCE($P{C_BPartner_UU}, '') = '' OR bp.c_bpartner_uu = $P{C_BPartner_UU})
			GROUP BY
				i.ad_client_id, i.c_invoice_id, i.dateinvoiced, bp.name, i.grandtotal
		) inv ON inv.ad_client_id = c.ad_client_id
WHERE
	c.ad_client_id = $P{AD_CLIENT_ID}
ORDER BY
	inv.dateinvoiced, inv.vendor_name;]]>
	</queryString>
