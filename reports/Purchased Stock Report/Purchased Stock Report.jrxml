	</variable>
	<variable name="sumBalanceDue" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_due} == null ? new java.math.BigDecimal(0) : $F{balance_due}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
