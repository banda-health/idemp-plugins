	<field name="received_by" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="received_by"/>
	</field>
	<variable name="sumTotalBill" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_bill} == null ? new java.math.BigDecimal(0) : $F{total_bill}]]></variableExpression>
		<initialValueExpression><![CDATA[new java.math.BigDecimal(0)]]></initialValueExpression>
	</variable>
	<variable name="sumAmountPaid" class="java.math.BigDecimal" calculation="Sum">
