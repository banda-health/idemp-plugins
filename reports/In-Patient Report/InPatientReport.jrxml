	<subDataset name="tableDataset" uuid="893302d0-3399-4789-9b40-faf0bf7f6d9a">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres UAT2 "/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer" isForPrompting="false"/>
		<parameter name="Patient Tags" class="java.util.List"/>
		<queryString>
			<![CDATA[SELECT
	bp.name                                AS patient_name,
	bp.bh_local_patientid                  AS patient_number,
	DATE_PART('year', AGE(bp.bh_birthday)) AS age,
	bp.bh_gender                           AS gender,
	bp.bh_phone                            AS phone_number,
	bp.totalopenbalance                    AS openbalance
FROM
	c_bpartner bp
		JOIN c_bp_group cbg
		ON bp.c_bp_group_id = cbg.c_bp_group_id AND cbg.NAME = 'Patients - DO NOT CHANGE'
WHERE
	bp.ad_client_id = $P{AD_CLIENT_ID}
	AND bp.isactive = 'Y'
		AND (
		$X{IN, bp.c_bpartner_uu, Patient Tags} OR
		bp.c_bpartner_id IN (
			SELECT
				c_bpartner_id
			FROM
				bh_bpartner_tags
			WHERE
				bh_tag_id IN (
					SELECT bh_tag_id
					FROM bh_tag
					WHERE $X{IN, bh_tag_uu, Patient Tags}
				)
		)
		)
ORDER BY
	bp.name;]]>
		</queryString>
		<field name="patient_name" class="java.lang.String"/>
		<field name="patient_number" class="java.lang.String"/>
		<field name="age" class="java.lang.Double"/>
		<field name="gender" class="java.lang.String"/>
		<field name="phone_number" class="java.lang.String"/>
		<field name="openbalance" class="java.lang.String"/>
	</subDataset>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT
	cl.name                                                                                   AS facility_name,
	oi.bh_facilitynumber,
	bp.name,
	bp.bh_patientid,
	STRING_AGG(DISTINCT iord.name || ': ' || bpgpi.name || '', ', ')                          AS insurance_info,
	bp.bh_birthday,
	EXTRACT(YEAR FROM AGE(bp.bh_birthday))                                                    AS age,
	v.bh_visitdate,
	CASE WHEN NOT is_finished THEN NULL ELSE v.updated END                                    AS discharge_date,
	CASE
		WHEN NOT is_finished THEN NULL
		ELSE FLOOR(EXTRACT(EPOCH FROM AGE(v.updated, v.bh_visitdate)) / (60 * 60 * 24)) + 1 END AS days_admitted,
	COALESCE(c.bh_display_name, ed.bh_uncoded_diagnosis)                                      AS primary_diagnosis,
	v.documentno                                                                              AS visit_no,
	STRING_AGG(DISTINCT iord.name || ': ' || i.documentno || '', ', ')                        AS insurance_invoice
FROM
	bh_visit v
		JOIN ad_client cl
			ON v.ad_client_id = cl.ad_client_id
		JOIN ad_org o
			ON cl.ad_client_id = o.ad_client_id
		JOIN ad_orginfo oi
			ON o.ad_org_id = oi.ad_org_id
		JOIN c_bpartner bp
			ON v.patient_id = bp.c_bpartner_id
		LEFT JOIN c_invoice i
			ON v.bh_visit_id = i.bh_visit_id AND bp.c_bpartner_id != i.c_bpartner_id AND docstatus IN ('CO', 'CL')
		LEFT JOIN c_bpartner iord
			ON i.c_bpartner_id = iord.c_bpartner_id
		LEFT JOIN c_bp_group bpg
			ON iord.c_bp_group_id = bpg.c_bp_group_id AND bpg.bh_subtype = 'I'
		LEFT JOIN bh_bp_payer_info bppi
			ON bppi.c_bpartner_id = bp.c_bpartner_id AND iord.c_bpartner_id = bppi.bh_payer_id
		LEFT JOIN bh_bp_general_payer_info bpgpi
			ON bppi.bh_bp_payer_info_id = bpgpi.bh_bp_payer_info_id
		LEFT JOIN bh_payer_info_fld pif
			ON bpgpi.bh_payer_info_fld_id = pif.bh_payer_info_fld_id
		LEFT JOIN bh_encounter e
			ON e.bh_visit_id = v.bh_visit_id AND e.bh_encounter_type = 'D'
		LEFT JOIN bh_encounter_diagnosis ed
			ON e.bh_encounter_id = ed.bh_encounter_id
		LEFT JOIN bh_concept c
			ON ed.bh_concept_id = c.bh_concept_id
		LEFT JOIN (
		SELECT
			bh_visit_id,
			CASE WHEN docstatus NOT IN ('CO', 'CL') THEN FALSE ELSE TRUE END AS is_finished
		FROM
			c_order
	) AS visit_info
			ON visit_info.bh_visit_id = v.bh_visit_id
WHERE
	v.bh_patienttype = 'I'
	AND (pif.name IS NULL OR pif.name = 'NHIF Number')
	AND (ed.lineno IS NULL OR ed.lineno = 0)
	AND visit_info.is_finished
	AND (v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date} OR v.updated BETWEEN $P{Begin Date} AND $P{End Date} OR
	     (v.bh_visitdate < $P{Begin Date} AND (EXISTS (
		     SELECT
			     1
		     FROM
			     c_order
		     WHERE
			     bh_visit_id = v.bh_visit_id
			     AND docstatus NOT IN ('CO', 'CL')
	     ) OR v.updated > $P{End Date})))
 	AND v.ad_client_id = $P{AD_CLIENT_ID}
GROUP BY
	bp.name, bp.bh_patientid, bp.bh_birthday, bp.bh_birthday, v.bh_visitdate, v.updated, v.updated, v.bh_visitdate,
	c.bh_display_name, ed.bh_uncoded_diagnosis, v.documentno, visit_info.is_finished, cl.name, oi.bh_facilitynumber;]]>
	</queryString>
