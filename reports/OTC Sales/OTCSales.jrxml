	<subDataset name="Cashier Payment Breakdown" uuid="feff5f8f-4432-4a34-bab3-4075a06f94c9">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="KB DB 12"/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
		<parameter name="Begin Date" class="java.sql.Timestamp"/>
		<parameter name="End Date" class="java.sql.Timestamp"/>
		<queryString language="SQL">
			<![CDATA[SELECT
	u.name      AS cashier_name,
	payment_mode_name,
	SUM(payamt) AS payamt
FROM
	bh_visit v
		JOIN c_order o
		ON v.bh_visit_id = o.bh_visit_id AND o.docstatus IN ('CO', 'CL')
		JOIN c_bpartner bp
		ON v.patient_id = bp.c_bpartner_id
		JOIN c_bp_group bpg
		ON bp.c_bp_group_id = bpg.c_bp_group_id AND bpg.name = 'OTC Patient'
		JOIN ad_user u
		ON o.salesrep_id = u.ad_user_id
		LEFT JOIN (
		SELECT
			bh_visit_id,
			payment_mode_name,
			SUM(payamt) AS payamt
		FROM
			bh_get_visit_payments($P{AD_CLIENT_ID}, $P{Begin Date}::timestamp, $P{End Date}::timestamp)
		GROUP BY bh_visit_id, payment_mode_name
	) patient_payment_sums
		ON v.bh_visit_id = patient_payment_sums.bh_visit_id
WHERE
	v.ad_client_id = $P{AD_CLIENT_ID}
	AND v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}
GROUP BY
	u.name, payment_mode_name]]>
		</queryString>
		<field name="cashier_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="cashier_name"/>
			<property name="com.jaspersoft.studio.field.label" value="cashier_name"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="ad_user"/>
		</field>
		<field name="payment_mode_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="payment_mode_name"/>
			<property name="com.jaspersoft.studio.field.label" value="payment_mode_name"/>
		</field>
		<field name="payamt" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="payamt"/>
			<property name="com.jaspersoft.studio.field.label" value="payamt"/>
		</field>
	</subDataset>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT
	TO_CHAR(v.bh_visitdate::date, 'YYYY-MM-DD') AS sale_date,
	TO_CHAR(v.bh_visitdate::time, 'HH12:MI AM') AS sale_time,
	p.name                                      AS product_name,
	ol.qtyordered                               AS quantity_sold,
	ol.priceentered                             AS unit_price,
	ol.linenetamt                               AS total_sale_amount,
	u.name                                      AS cashier_name
FROM
	bh_visit v
		JOIN c_order o
		ON v.bh_visit_id = o.bh_visit_id AND o.docstatus IN ('CO', 'CL')
		JOIN c_orderline ol
		ON o.c_order_id = ol.c_order_id
		JOIN c_bpartner bp
		ON v.patient_id = bp.c_bpartner_id
		JOIN c_bp_group bpg
		ON bp.c_bp_group_id = bpg.c_bp_group_id AND bpg.name = 'OTC Patient'
		JOIN ad_user u
		ON o.salesrep_id = u.ad_user_id
		JOIN m_product p
		ON ol.m_product_id = p.m_product_id
WHERE
	v.ad_client_id = $P{AD_CLIENT_ID}
	AND ol.included_orderline_id IS NULL
	AND v.bh_visitdate BETWEEN $P{Begin Date} AND $P{End Date}]]>
	</queryString>
