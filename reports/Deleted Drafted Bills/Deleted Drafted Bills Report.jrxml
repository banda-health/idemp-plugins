	<subDataset name="Deleted Drafted Bills" uuid="4ddff745-c801-490f-9e16-520912866ea0">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="postgres UAT2 "/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
		<parameter name="Begin Date" class="java.sql.Timestamp"/>
		<parameter name="End Date" class="java.sql.Timestamp"/>
		<queryString>
			<![CDATA[WITH table_ids AS (
SELECT ad_table_id AS visit FROM ad_table WHERE ad_table_uu = 'd2c9b934-ef14-483f-ac29-6a68611b0552'
),
column_ids AS (
SELECT
(
SELECT ad_column_id FROM ad_column WHERE ad_column_uu = 'ef5e312d-e5c6-45b0-a074-4c70edef02ca'
) AS visit_visit_id,
(
SELECT ad_column_id FROM ad_column WHERE ad_column_uu = 'ee4a2d92-b848-414a-b272-881f3df597c6'
) AS visit_date,
(
SELECT ad_column_id FROM ad_column WHERE ad_column_uu = '948a726d-0219-4051-a7e0-a04441e17cf9'
) AS patient_id,
(
SELECT ad_column_id FROM ad_column WHERE ad_column_uu = 'ae09c94f-ec03-4809-9544-1aefb4075799'
) AS payment_visit_id,
(
SELECT ad_column_id FROM ad_column WHERE ad_column_uu = '995dda29-0bb0-4e54-bc40-a5689ce5d9ab'
) AS tender_amount
)
SELECT
u.name                    AS deleted_by,
bp.name                   AS patient_name,
cl_v.oldvalue             AS visit_date,
cl_pt.oldvalue            AS bill_amount,
COALESCE(bp.bh_phone, '') AS phone
FROM
ad_user u
CROSS JOIN table_ids
CROSS JOIN column_ids
JOIN ad_changelog cl
ON cl.createdby = u.ad_user_id AND cl.ad_client_id = $P{AD_CLIENT_ID} AND cl.ad_table_id = table_ids.visit AND
   cl.ad_column_id = column_ids.visit_visit_id AND cl.newvalue = 'NULL' AND
   cl.created BETWEEN $P{Begin Date} AND $P{End Date}
JOIN ad_changelog cl_v
ON cl.record_id = cl_v.record_id AND
   cl_v.ad_table_id = table_ids.visit AND
   cl_v.ad_column_id = column_ids.visit_date AND
   cl_v.newvalue = 'NULL'
JOIN ad_changelog cl_bp
ON cl.record_id = cl_bp.record_id AND
   cl_bp.ad_table_id = table_ids.visit AND
   cl_bp.ad_column_id = column_ids.patient_id AND
   cl_bp.newvalue = 'NULL'
JOIN c_bpartner bp
ON cl_bp.oldvalue::numeric = bp.c_bpartner_id
LEFT JOIN ad_changelog cl_p
ON cl_p.ad_table_id = 335 AND
   cl_p.ad_column_id = column_ids.payment_visit_id AND
   cl_p.oldvalue = cl.oldvalue AND
   cl_p.newvalue = 'NULL'
LEFT JOIN ad_changelog cl_pt
ON cl_p.record_id = cl_pt.record_id AND
   cl_pt.ad_table_id = 335 AND
   cl_pt.ad_column_id = column_ids.tender_amount AND
   cl_pt.newvalue = 'NULL'
ORDER BY
cl.created DESC;]]>
		</queryString>
		<field name="deleted_by" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="deleted_by"/>
		</field>
		<field name="patient_name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="patient_name"/>
		</field>
		<field name="visit_date" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.label" value="visit_date"/>
		</field>
		<field name="bill_amount" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="bill_amount"/>
		</field>
		<field name="phone" class="java.lang.String"/>
	</subDataset>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select 1;]]>
	</queryString>
