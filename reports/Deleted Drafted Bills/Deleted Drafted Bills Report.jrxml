	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[WITH table_ids AS (
	SELECT ad_table_id AS visit FROM ad_table WHERE ad_table_uu = 'd2c9b934-ef14-483f-ac29-6a68611b0552'
),
	column_ids AS (
		SELECT
			(
				SELECT ad_column_id FROM ad_column WHERE ad_column_uu = 'ef5e312d-e5c6-45b0-a074-4c70edef02ca'
			) AS visit_visit_id,
			(
				SELECT ad_column_id FROM ad_column WHERE ad_column_uu = '948a726d-0219-4051-a7e0-a04441e17cf9'
			) AS patient_id,
			(
				SELECT ad_column_id FROM ad_column WHERE ad_column_uu = '8d840880-1948-44d5-b160-c309c8b49716'
			) AS order_visit_id,
			(
				SELECT ad_column_id FROM ad_column WHERE ad_column_uu = 'ca406cda-d315-4db1-9cbb-6a2305bb3d29'
			) AS grandtotal
	)
SELECT
	u.name                    AS deleted_by,
	bp.name                   AS patient_name,
	cl.created                AS deleted_at,
	cl_gt.oldvalue::numeric   AS bill_amount,
	COALESCE(bp.bh_phone, '') AS phone
FROM
	ad_user u
		CROSS JOIN table_ids
		CROSS JOIN column_ids
		JOIN ad_changelog cl
			ON cl.ad_column_id = column_ids.visit_visit_id AND cl.createdby = u.ad_user_id AND
			   cl.ad_client_id = $P{AD_CLIENT_ID} AND cl.newvalue = 'NULL' AND cl.created BETWEEN $P{Begin Date} AND $P{End Date}
		JOIN ad_changelog cl_bp
			ON cl_bp.ad_table_id = table_ids.visit AND
			   cl.record_id = cl_bp.record_id AND
			   cl_bp.ad_column_id = column_ids.patient_id AND
			   cl_bp.newvalue = 'NULL'
		JOIN c_bpartner bp
			ON cl_bp.oldvalue::numeric = bp.c_bpartner_id
		LEFT JOIN ad_changelog cl_o
			ON cl_o.ad_column_id = column_ids.order_visit_id AND
			   cl_o.oldvalue = cl.oldvalue AND
			   cl_o.newvalue = 'NULL'
		LEFT JOIN ad_changelog cl_gt
			ON cl_gt.ad_table_id = 259 AND
			   cl_o.record_id = cl_gt.record_id AND
			   cl_gt.ad_column_id = column_ids.grandtotal AND
			   cl_gt.newvalue = 'NULL'
ORDER BY
	cl.created DESC;]]>
	</queryString>
