								? new java.text.SimpleDateFormat("dd/MM/yyyy").format(new java.util.Date(Long.parseLong($F{lmp}) * 1000L))
								: $F{lmp}.replaceFirst("\\s.*$", "")))
						: "")]]></textFieldExpression>
