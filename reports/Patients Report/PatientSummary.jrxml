	<subDataset name="MedicationDataSet" uuid="9a1b7d63-4aa2-4b35-a2df-9f9c4b0b9c5a">
		<parameter name="BH_Visit_UU" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
	ROW_NUMBER() OVER (ORDER BY ol.created) 	AS line_no,
	p.name                                     	AS medication_name,
	COALESCE(ol.description, '')           		AS instructions
FROM
	bh_visit v
		JOIN c_order o
			ON v.bh_visit_id = o.bh_visit_id
		JOIN c_orderline ol
			ON o.c_order_id = ol.c_order_id
		JOIN m_product p
			ON ol.m_product_id = p.m_product_id AND p.producttype = 'I'
WHERE
	o.issotrx = 'Y'
	AND ol.included_orderline_id IS NULL
	AND v.bh_visit_uu = $P{BH_Visit_UU}
ORDER BY
	ol.created;]]>
		</queryString>
		<field name="line_no" class="java.lang.Integer"/>
		<field name="medication_name" class="java.lang.String"/>
		<field name="instructions" class="java.lang.String"/>
	</subDataset>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH visit AS (
	SELECT
		v.bh_visit_id,
		v.documentno                                          AS ip_op_number,
		v.bh_visitdate                                        AS visit_date,
		v.patient_id,
		v.ad_org_id,
		v.bh_clinician_user_id,
		v.bh_referral                                         AS referral_reason,
		v.bh_referredfromto                                   AS referred_to,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'C'
				AND f.ad_field_uu = 'e1d01fe4-16b6-4125-a385-34cf4531c06f'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS chief_complaint,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
					JOIN ad_column c ON f.ad_column_id = c.ad_column_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'D'
				AND c.ad_column_uu = '9bcfded3-3af9-41d3-94ae-319d1859bb30'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS clinical_notes,
		NULLIF(
			COALESCE(
				(
					SELECT
						o.bh_value
					FROM
						bh_observation o
							JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
							JOIN ad_field f ON o.ad_field_id = f.ad_field_id
							JOIN ad_column c ON f.ad_column_id = c.ad_column_id
					WHERE
						e.bh_visit_id = v.bh_visit_id
						AND e.bh_encounter_type = 'V'
						AND f.ad_field_uu = 'cd376ad7-d03b-4970-ab2b-34ef000b93f9'
					ORDER BY
						o.created DESC
					LIMIT 1
				), ''
			)
			||
			CASE
				WHEN
					(
						SELECT
							o.bh_value
						FROM
							bh_observation o
								JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
								JOIN ad_field f ON o.ad_field_id = f.ad_field_id
								JOIN ad_column c ON f.ad_column_id = c.ad_column_id
						WHERE
							e.bh_visit_id = v.bh_visit_id
							AND e.bh_encounter_type = 'V'
							AND f.ad_field_uu = 'cd376ad7-d03b-4970-ab2b-34ef000b93f9'
						ORDER BY
							o.created DESC
						LIMIT 1
					) IS NOT NULL
					AND
					(
						SELECT
							o.bh_value
						FROM
							bh_observation o
								JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
								JOIN ad_field f ON o.ad_field_id = f.ad_field_id
								JOIN ad_column c ON f.ad_column_id = c.ad_column_id
						WHERE
							e.bh_visit_id = v.bh_visit_id
							AND e.bh_encounter_type = 'V'
							AND f.ad_field_uu = '769b6475-1e35-4618-ad36-09fa0111affb'
						ORDER BY
							o.created DESC
						LIMIT 1
					) IS NOT NULL
				THEN '/'
				ELSE ''
			END
			||
			COALESCE(
				(
					SELECT
						o.bh_value
					FROM
						bh_observation o
							JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
							JOIN ad_field f ON o.ad_field_id = f.ad_field_id
							JOIN ad_column c ON f.ad_column_id = c.ad_column_id
					WHERE
						e.bh_visit_id = v.bh_visit_id
						AND e.bh_encounter_type = 'V'
						AND f.ad_field_uu = '769b6475-1e35-4618-ad36-09fa0111affb'
					ORDER BY
						o.created DESC
					LIMIT 1
				), ''
			),
			''
		) AS blood_pressure,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'V'
				AND f.ad_field_uu = 'd3dc091f-ee3d-4607-91d1-4e766cfe5528'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS temperature,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'V'
				AND f.ad_field_uu = 'c0f0f904-4977-4360-8065-a0e91d4f3a71'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS pulse,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'V'
				AND f.ad_field_uu = '7bb73318-f6cc-4540-85d7-69672a18cc5f'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS spo2,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
					JOIN ad_column c ON f.ad_column_id = c.ad_column_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'V'
				AND f.ad_field_uu = '87183dfb-1b7d-4c18-b350-593e576bb49b'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS rr,
		(
			SELECT
				o.bh_value
			FROM
				bh_observation o
					JOIN bh_encounter e ON o.bh_encounter_id = e.bh_encounter_id
					JOIN ad_field f ON o.ad_field_id = f.ad_field_id
					JOIN ad_column c ON f.ad_column_id = c.ad_column_id
			WHERE
				e.bh_visit_id = v.bh_visit_id
				AND e.bh_encounter_type = 'V'
				AND f.ad_field_uu = 'da211453-46c6-44a6-8ee2-ded8f8630b23'
			ORDER BY
				o.created DESC
			LIMIT 1
		) AS lmp,
		(
			SELECT
				MIN(v2.bh_visitdate)
			FROM
				bh_visit v2
			WHERE
				v2.patient_id = v.patient_id
				AND v2.bh_visit_id != v.bh_visit_id
				AND v2.bh_visitdate > v.bh_visitdate
				AND v2.scheduled = 'Y'
		) AS next_appointment_date
	FROM
		bh_visit v
	WHERE
		v.bh_visit_uu = $P{BH_Visit_UU}
	LIMIT 1
),
patient AS (
	SELECT
		bp.c_bpartner_id,
		bp.name                                     AS full_name,
		bp.bh_patientid                             AS id_passport_number,
		bp.bh_phone                                 AS contact_number,
		CAST(DATE_PART('year', AGE(bp.bh_birthday)) AS INTEGER) AS age_years,
		bp.bh_gender                                AS gender_display
	FROM
		visit v
		JOIN c_bpartner bp
			ON v.patient_id = bp.c_bpartner_id
),
diagnoses AS (
	SELECT
		e.bh_visit_id,
		ev.bh_concept_id,
		ev.bh_uncoded_diagnosis,
		ROW_NUMBER() OVER (PARTITION BY e.bh_visit_id ORDER BY ev.lineno) AS diagnosis_rank
	FROM
		bh_visit v
		JOIN bh_encounter e
			ON v.bh_visit_id = e.bh_visit_id
		LEFT JOIN bh_encounter_diagnosis ev
			ON e.bh_encounter_id = ev.bh_encounter_id
	WHERE
		v.bh_visit_uu = $P{BH_Visit_UU}
),
primary_d AS (
	SELECT * FROM diagnoses WHERE diagnosis_rank = 1
),
secondary_d AS (
	SELECT
		d.bh_visit_id,
		STRING_AGG(COALESCE(c.bh_display_name, d.bh_uncoded_diagnosis), ', ' ORDER BY d.diagnosis_rank) AS secondary_diagnosis_text
	FROM diagnoses d
		LEFT JOIN bh_concept c
			ON c.bh_concept_id = d.bh_concept_id
	WHERE d.diagnosis_rank >= 2
	GROUP BY d.bh_visit_id
)
SELECT
	p.full_name,
	v.ip_op_number,
	p.age_years,
	p.gender_display,
	p.id_passport_number,
	p.contact_number,
	v.chief_complaint,
	v.clinical_notes,
	v.blood_pressure,
	v.temperature,
	v.pulse,
	v.spo2,
	v.rr,
	v.lmp,
	v.next_appointment_date,
	v.referral_reason,
	v.referred_to,
	COALESCE(pc.bh_display_name, pd.bh_uncoded_diagnosis) AS primary_diagnosis,
	COALESCE(sd.secondary_diagnosis_text, '') AS secondary_diagnosis,
	o.name                                                AS clinic_name,
	u.name                                                AS clinician_name
FROM
	visit v
	JOIN patient p
		ON 1 = 1
	LEFT JOIN primary_d pd
		ON v.bh_visit_id = pd.bh_visit_id
	LEFT JOIN secondary_d sd
		ON v.bh_visit_id = sd.bh_visit_id
	LEFT JOIN bh_concept pc
		ON pc.bh_concept_id = pd.bh_concept_id
	JOIN ad_org o
		ON v.ad_org_id = o.ad_org_id
	LEFT JOIN ad_user u
		ON v.bh_clinician_user_id = u.ad_user_id;]]>
	</queryString>
	<field name="full_name" class="java.lang.String"/>
	<field name="ip_op_number" class="java.lang.String"/>
	<field name="age_years" class="java.lang.Integer"/>
	<field name="gender_display" class="java.lang.String"/>
	<field name="id_passport_number" class="java.lang.String"/>
	<field name="contact_number" class="java.lang.String"/>
	<field name="chief_complaint" class="java.lang.String"/>
	<field name="clinical_notes" class="java.lang.String"/>
	<field name="blood_pressure" class="java.lang.String"/>
	<field name="temperature" class="java.lang.String"/>
	<field name="pulse" class="java.lang.String"/>
	<field name="spo2" class="java.lang.String"/>
	<field name="rr" class="java.lang.String"/>
	<field name="lmp" class="java.lang.String"/>
	<field name="next_appointment_date" class="java.sql.Timestamp"/>
	<field name="referral_reason" class="java.lang.String"/>
	<field name="referred_to" class="java.lang.String"/>
	<field name="primary_diagnosis" class="java.lang.String"/>
	<field name="secondary_diagnosis" class="java.lang.String"/>
	<field name="clinic_name" class="java.lang.String"/>
	<field name="clinician_name" class="java.lang.String"/>
