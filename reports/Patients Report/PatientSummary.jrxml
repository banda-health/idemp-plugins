				<text><![CDATA[2. CLINICAL SUMMARY]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="160" width="481" height="14" uuid="a1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e"/>
