					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Chief Complaint (Reason for Visit):]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="0" y="176" width="481" height="30" uuid="b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5f"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[(($F{chief_complaint} != null) ? $F{chief_complaint}
	.replace("\r\n", ", ")
	.replace("\n", ", ")
	.replace("\r", ", ")
	.replaceAll(",\\s*,+", ", ")
	.replaceAll("\\s{2,}", " ")
	.replaceAll("^,\\s*|,\\s*$", "") : "")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="210" width="210" height="14" uuid="a1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d60"/>
				<textElement>
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Brief History & Physical Findings:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement x="0" y="226" width="481" height="54" uuid="b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d61">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				</reportElement>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{clinical_notes}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="140" width="42" height="16" uuid="6d2bd58a-3a3f-4f2c-a3bc-1e0b6a6c9f10"/>
				<textElement>
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[Vitals:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="44" y="140" width="437" height="16" uuid="e2f3a4b5-c6d7-4e5f-8a9b-0c1d2e3f4a5b"/>
				<textElement>
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["BP: " + ($F{blood_pressure} != null ? $F{blood_pressure} : "") +
						"   Temp: " + ($F{temperature} != null ? $F{temperature} : "") +
						"   Pulse: " + ($F{pulse} != null ? $F{pulse} : "") +
						"   RR: " + ($F{rr} != null ? $F{rr} : "") +
						"   SpO2: " + ($F{spo2} != null ? $F{spo2} : "") +
						"   LMP: " + (($F{lmp} != null && !$F{lmp}.trim().isEmpty())
						? ($F{lmp}.matches("^\\d{13}$")
