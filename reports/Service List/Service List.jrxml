	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
	p.name      AS product,
	pc.name     AS category,
	pp.pricestd AS charge
FROM
	m_product p
		JOIN m_product_category pc
		ON p.m_product_category_id = pc.m_product_category_id
		JOIN m_productprice pp
		ON p.m_product_id = pp.m_product_id
		JOIN m_pricelist_version plv
		ON pp.m_pricelist_version_id = plv.m_pricelist_version_id AND plv.isactive = 'Y'
		LEFT JOIN m_pricelist_version plv2
		ON plv.m_pricelist_id = plv2.m_pricelist_id AND plv2.validfrom > plv.validfrom AND
		   plv.m_pricelist_version_id != plv2.m_pricelist_version_id
		JOIN m_pricelist pl
		ON plv.m_pricelist_id = pl.m_pricelist_id AND pl.issopricelist = 'Y' AND pl.isdefault = 'Y'
WHERE
	plv2.m_pricelist_id IS NULL
	AND p.ad_client_id = $P{AD_CLIENT_ID}
	AND p.producttype = 'S'
	AND p.isactive = 'Y'
ORDER BY
	p.name, pc.name, pp.pricestd;]]>
	</queryString>
