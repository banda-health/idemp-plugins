	<subDataset name="MedicationDataSet" uuid="9a1b7d63-4aa2-4b35-a2df-9f9c4b0b9c5a">
		<parameter name="BH_Visit_UU" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
	ROW_NUMBER() OVER (ORDER BY ol.created) 	AS line_no,
	p.name                                     	AS medication_name,
	COALESCE(ol.description, '')           		AS instructions
FROM
	bh_visit v
		JOIN c_order o
			ON v.bh_visit_id = o.bh_visit_id
		JOIN c_orderline ol
			ON o.c_order_id = ol.c_order_id
		JOIN m_product p
			ON ol.m_product_id = p.m_product_id
WHERE
	o.issotrx = 'Y'
	AND ol.included_orderline_id IS NULL
	AND v.bh_visit_uu = $P{BH_Visit_UU}
ORDER BY
	ol.created;]]>
		</queryString>
		<field name="line_no" class="java.lang.Integer"/>
		<field name="medication_name" class="java.lang.String"/>
		<field name="instructions" class="java.lang.String"/>
	</subDataset>
	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH visit_base AS (
	SELECT
		bh_visit_id
	FROM
		bh_visit
	WHERE
		bh_visit_uu = $P{BH_Visit_UU}
),
	obs AS (
		SELECT DISTINCT ON (obs_label)
			obs_label,
			bh_value
		FROM
			(
				SELECT
					CASE
						WHEN f.ad_field_uu = 'e1d01fe4-16b6-4125-a385-34cf4531c06f' THEN 'chief_complaint'
						WHEN c.ad_column_uu = '9bcfded3-3af9-41d3-94ae-319d1859bb30' THEN 'clinical_notes'
						WHEN f.ad_field_uu = 'cd376ad7-d03b-4970-ab2b-34ef000b93f9' THEN 'bp_systolic'
						WHEN f.ad_field_uu = '769b6475-1e35-4618-ad36-09fa0111affb' THEN 'bp_diastolic'
						WHEN f.ad_field_uu = 'd3dc091f-ee3d-4607-91d1-4e766cfe5528' THEN 'temperature'
						WHEN f.ad_field_uu = 'c0f0f904-4977-4360-8065-a0e91d4f3a71' THEN 'pulse'
						WHEN f.ad_field_uu = '7bb73318-f6cc-4540-85d7-69672a18cc5f' THEN 'spo2'
						WHEN f.ad_field_uu = '87183dfb-1b7d-4c18-b350-593e576bb49b' THEN 'rr'
						WHEN f.ad_field_uu = 'da211453-46c6-44a6-8ee2-ded8f8630b23' THEN 'lmp'
						END AS obs_label,
					o.bh_value,
					o.created
				FROM
					visit_base vb
						JOIN bh_encounter e
							ON e.bh_visit_id = vb.bh_visit_id
						JOIN bh_observation o
							ON o.bh_encounter_id = e.bh_encounter_id
						JOIN ad_field f
							ON o.ad_field_id = f.ad_field_id
						LEFT JOIN ad_column c
							ON f.ad_column_id = c.ad_column_id
				WHERE
					(e.bh_encounter_type = 'C' AND f.ad_field_uu = 'e1d01fe4-16b6-4125-a385-34cf4531c06f')
					OR (e.bh_encounter_type = 'D' AND c.ad_column_uu = '9bcfded3-3af9-41d3-94ae-319d1859bb30')
					OR (e.bh_encounter_type = 'V' AND f.ad_field_uu IN (
					                                                    'cd376ad7-d03b-4970-ab2b-34ef000b93f9',
					                                                    '769b6475-1e35-4618-ad36-09fa0111affb',
					                                                    'd3dc091f-ee3d-4607-91d1-4e766cfe5528',
					                                                    'c0f0f904-4977-4360-8065-a0e91d4f3a71',
					                                                    '7bb73318-f6cc-4540-85d7-69672a18cc5f',
					                                                    '87183dfb-1b7d-4c18-b350-593e576bb49b',
					                                                    'da211453-46c6-44a6-8ee2-ded8f8630b23'
						))
			) labeled
		ORDER BY obs_label, created DESC
	),
	vitals AS (
		SELECT
			vb.bh_visit_id,
			MAX(CASE WHEN obs_label = 'chief_complaint' THEN bh_value END) AS chief_complaint,
			MAX(CASE WHEN obs_label = 'clinical_notes' THEN bh_value END)  AS clinical_notes,
			NULLIF(
					COALESCE(MAX(CASE WHEN obs_label = 'bp_systolic' THEN bh_value END), '')
						|| CASE
							   WHEN MAX(CASE WHEN obs_label = 'bp_systolic' THEN bh_value END) IS NOT NULL
								   AND MAX(CASE WHEN obs_label = 'bp_diastolic' THEN bh_value END) IS NOT NULL
								   THEN '/'
							   ELSE ''
						END
						|| COALESCE(MAX(CASE WHEN obs_label = 'bp_diastolic' THEN bh_value END), ''),
					''
			)                                                              AS blood_pressure,
			MAX(CASE WHEN obs_label = 'temperature' THEN bh_value END)     AS temperature,
			MAX(CASE WHEN obs_label = 'pulse' THEN bh_value END)           AS pulse,
			MAX(CASE WHEN obs_label = 'spo2' THEN bh_value END)            AS spo2,
			MAX(CASE WHEN obs_label = 'rr' THEN bh_value END)              AS rr,
			MAX(CASE WHEN obs_label = 'lmp' THEN bh_value END)             AS lmp
		FROM
			visit_base vb
				LEFT JOIN obs
					ON TRUE
		GROUP BY
			vb.bh_visit_id
	),
	patient AS (
		SELECT
			bp.c_bpartner_id,
			bp.name,
			bp.bh_patientid,
			bp.bh_phone,
			bp.bh_gender,
			CASE
				WHEN bp.bh_birthday IS NULL THEN ''
				WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) >= 2
					THEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date))::int || ' years'
				WHEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
					+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int >= 2
					THEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
					+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int || ' months'
				WHEN (CURRENT_DATE - bp.bh_birthday::date) >= 15
					THEN (CURRENT_DATE - bp.bh_birthday::date) / 7 || ' weeks'
					|| CASE
						   WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 0 THEN ''
						   WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 1 THEN ', 1 day'
						   ELSE ', ' || (CURRENT_DATE - bp.bh_birthday::date) % 7 || ' days'
						     END
				WHEN (CURRENT_DATE - bp.bh_birthday::date) = 1 THEN '1 day'
				ELSE (CURRENT_DATE - bp.bh_birthday::date) || ' days'
				END AS age_display
		FROM
			visit_base vb
				JOIN bh_visit v
					ON vb.bh_visit_id = v.bh_visit_id
				JOIN c_bpartner bp
					ON v.patient_id = bp.c_bpartner_id
	),
	diagnoses AS (
		SELECT
			e.bh_visit_id,
			ev.bh_concept_id,
			ev.bh_uncoded_diagnosis,
			ROW_NUMBER() OVER (PARTITION BY e.bh_visit_id ORDER BY ev.lineno) AS diagnosis_rank
		FROM
			visit_base vb
				JOIN bh_encounter e
					ON vb.bh_visit_id = e.bh_visit_id
				LEFT JOIN bh_encounter_diagnosis ev
					ON e.bh_encounter_id = ev.bh_encounter_id
	),
	primary_d AS (
		SELECT *
		FROM
			diagnoses
		WHERE
			diagnosis_rank = 1
	),
	secondary_d AS (
		SELECT
			d.bh_visit_id,
			STRING_AGG(COALESCE(c.bh_display_name, d.bh_uncoded_diagnosis), ', '
			           ORDER BY d.diagnosis_rank) AS secondary_diagnosis_text
		FROM
			diagnoses d
				LEFT JOIN bh_concept c
					ON c.bh_concept_id = d.bh_concept_id
		WHERE
			d.diagnosis_rank >= 2
		GROUP BY d.bh_visit_id
	)
SELECT
	bp.name                                               AS patient_name,
	v.documentno                                          AS visit_number,
	v.bh_visitdate,
	CASE
		WHEN bp.bh_birthday IS NULL THEN ''
		WHEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) >= 2
			THEN EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date))::int || ' years'
		WHEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
			+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int >= 2
			THEN (EXTRACT(YEAR FROM AGE(CURRENT_DATE, bp.bh_birthday::date)) * 12
			+ EXTRACT(MONTH FROM AGE(CURRENT_DATE, bp.bh_birthday::date)))::int || ' months'
		WHEN (CURRENT_DATE - bp.bh_birthday::date) >= 15
			THEN (CURRENT_DATE - bp.bh_birthday::date) / 7 || ' weeks'
			|| CASE
				   WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 0 THEN ''
				   WHEN (CURRENT_DATE - bp.bh_birthday::date) % 7 = 1 THEN ', 1 day'
				   ELSE ', ' || (CURRENT_DATE - bp.bh_birthday::date) % 7 || ' days'
				     END
		WHEN (CURRENT_DATE - bp.bh_birthday::date) = 1 THEN '1 day'
		ELSE (CURRENT_DATE - bp.bh_birthday::date) || ' days'
		END                                                 AS age_display,
	bp.bh_gender,
	bp.bh_patientid,
	vit.chief_complaint,
	vit.clinical_notes,
	vit.blood_pressure,
	vit.temperature,
	vit.pulse,
	vit.spo2,
	vit.rr,
	vit.lmp,
	(
		SELECT
			MIN(v2.bh_visitdate)
		FROM
			bh_visit v2
		WHERE
			v2.patient_id = v.patient_id
			AND v2.bh_visit_id != vb.bh_visit_id
			AND v2.bh_visitdate > v.bh_visitdate
			AND v2.scheduled = 'Y'
	)                                                     AS next_appointment_date,
	v.bh_referredfromto,
	COALESCE(pc.bh_display_name, pd.bh_uncoded_diagnosis) AS primary_diagnosis,
	COALESCE(sd.secondary_diagnosis_text, '')             AS secondary_diagnosis,
	o.name                                                AS clinic_name,
	u.name                                                AS clinician_name
FROM
	visit_base vb
		JOIN bh_visit v
			ON vb.bh_visit_id = v.bh_visit_id
		JOIN vitals vit
			ON v.bh_visit_id = vit.bh_visit_id
		JOIN c_bpartner bp
			ON v.patient_id = bp.c_bpartner_id
		LEFT JOIN primary_d pd
			ON v.bh_visit_id = pd.bh_visit_id
		LEFT JOIN secondary_d sd
			ON v.bh_visit_id = sd.bh_visit_id
		LEFT JOIN bh_concept pc
			ON pc.bh_concept_id = pd.bh_concept_id
		JOIN ad_org o
			ON v.ad_org_id = o.ad_org_id
		LEFT JOIN ad_user u
			ON v.bh_clinician_user_id = u.ad_user_id;]]>
	</queryString>
