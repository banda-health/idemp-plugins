	<detail>
		<band height="86" splitType="Stretch">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<line>
				<reportElement x="0" y="1" width="481" height="1" uuid="7e6d9db3-2d3b-4d4d-8bdc-0c0a2d3f9c21"/>
				<graphicElement>
					<pen lineWidth="1.0" lineStyle="Solid"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement style="SectionHeading" x="0" y="8" width="481" height="18" uuid="f6d3e0d1-0b2a-4d4c-9cc3-6c3b4c6d3a11"/>
				<text><![CDATA[1. PATIENT IDENTIFICATION]]></text>
			</staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true">
				<reportElement x="0" y="28" width="481" height="16" uuid="c6c6a6a8-3c5c-4b0a-8d6e-1c2b3d4e5f6a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box rightPadding="3"/>
				<textElement markup="html"/>
				<textFieldExpression><![CDATA["<b>Full Name:</b> " + ($F{patient_name} != null ? $F{patient_name} : "") + "     <b>Age:</b> " + $F{age_display}+ "     <b>Gender:</b> " +
					($F{bh_gender} != null && !$F{bh_gender}.trim().isEmpty()
						? $F{bh_gender}.substring(0,1).toUpperCase() + $F{bh_gender}.substring(1).toLowerCase()
						: "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true">
				<reportElement x="0" y="46" width="240" height="16" uuid="c6c6a6a8-3c5c-4b0a-8d6e-1c2b3d4e5f6b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement markup="html"/>
				<textFieldExpression><![CDATA["<b>Patient Number:</b> " + ($F{bh_patientid} != null ? $F{bh_patientid} : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true">
				<reportElement x="0" y="64" width="240" height="16" uuid="c6c6a6a8-3c5c-4b0a-8d6e-1c2b3d4e5f6c">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box rightPadding="3"/>
				<textElement markup="html"/>
