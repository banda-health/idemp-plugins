	<parameter name="BH_Visit_UU" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	o.ad_org_id,
	logo.binarydata                    AS image,
	o.name                             AS Client_name,
	REPLACE(REPLACE(
            CONCAT(l.address1 || ', ', l.address2 || ', ',
                   l.address3 || ', ', l.address4 || ', ')
	        || '#END#', ', #END#', ''),
	        '#END#', '') AS address,
	COALESCE(oi.phone, oi.phone2)      AS phone,
	oi.bh_header                       AS header,
	city
FROM
	bh_visit v
		JOIN ad_org o
		ON v.ad_client_id = o.ad_client_id
		INNER JOIN ad_orginfo oi
		ON o.ad_org_id = oi.ad_org_id
		LEFT JOIN c_location l
		ON oi.c_location_id = l.c_location_id
		LEFT JOIN ad_image logo
		ON oi.logo_id = logo.ad_image_id
WHERE
	v.bh_visit_uu = $P{BH_Visit_UU}
ORDER BY
	header NULLS LAST, oi.updated DESC
LIMIT 1]]>
	</queryString>
	<field name="ad_org_id" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="ad_org_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ad_org"/>
	</field>
	<field name="image" class="java.lang.Object">
