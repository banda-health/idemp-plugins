<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IncomeStatementProfitAndLoss" pageWidth="800" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="093e33fd-6ca1-46bd-93fb-3f1a8bb1e4d5">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter1.jrdax"/>
	<parameter name="Begin Date" class="java.sql.Timestamp"/>
	<parameter name="End Date" class="java.sql.Timestamp"/>
	<parameter name="AD_CLIENT_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
	COALESCE(l.address1, '') AS county,
	COALESCE(l.address2, '') AS subcounty,
	COALESCE(l.address3, '') AS ward,
	cl.name                  AS org_name
FROM
	ad_client cl
		JOIN (
		SELECT *
		FROM
			ad_orginfo
		WHERE
			ad_client_id = $P{AD_CLIENT_ID}
		ORDER BY ad_org_id
		LIMIT 1
	) oi
		ON cl.ad_client_id = oi.ad_client_id
		LEFT JOIN c_location l
		ON oi.c_location_id = l.c_location_id
WHERE
	cl.ad_client_id = $P{AD_CLIENT_ID}]]>
	</queryString>
	<field name="org_name" class="java.lang.String"/>
