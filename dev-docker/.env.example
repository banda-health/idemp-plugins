IDEMPIERE_HOME=/opt/idempiere

# Host path to idemp-banda repo root (relative to dev-docker/ or absolute)
PLUGINS_MOUNT=..

# In-container path where the repo is mounted
PLUGINS_CONTAINER_DIR=/workspace/idemp-banda

# Optional: override host UID/GID baked into the developer user at image build time.
# dev.sh --build sets these from id -u / id -g when unset.
# HOST_UID=1000
# HOST_GID=1000

# Eclipse workspace, Maven cache, and Studio workspace are baked into the dev image
# (./dev.sh capture + push). Only the repo is bind-mounted (PLUGINS_MOUNT above).
# Optional: docker-compose.build-overlays.yml adds named volumes for Windows drvfs
# Maven permission issues — not used by ./dev.sh by default.

# Run pending DB migrations when the dev container starts (via docker-entrypoint.sh)
RUN_MIGRATIONS_ON_START=true

# Host port -> container 8080 (iDempiere HTTP)
IDEMPIERE_HTTP_PORT=8080

# iDempiere always uses localhost:5432 inside the container (PgBouncer db-proxy).
# DB_TARGET=host     -> upstream is host Postgres at DB_HOST_PORT (default; no compose postgres service)
# DB_TARGET=compose  -> ./dev.sh merges docker-compose.postgres.yml (pulls/runs IDEMPIERE_DB_IMAGE)
DB_TARGET=host
DB_HOST_PORT=5432

# Credentials shown in iDempiere UI (any value works on localhost; PgBouncer ignores them).
DB_DEFAULT_USER=adempiere
DB_DEFAULT_PASSWORD=adempiere

# Real upstream app database (iDempiere UI can still say "idempiere").
DB_UPSTREAM_DATABASE=idempiere
DB_UPSTREAM_USER=adempiere
DB_UPSTREAM_PASSWORD=adempiere

# Real upstream admin database (Server Setup template1 check).
DB_UPSTREAM_ADMIN_DATABASE=template1
DB_UPSTREAM_ADMIN_USER=postgres
DB_UPSTREAM_ADMIN_PASSWORD=postgres

# When DB_TARGET=compose (docker-compose.postgres.yml is merged automatically)
DB_COMPOSE_HOST=postgres

# Baked develop DB from TeamCity (Route C: PGDATA in image, no .dmp in layers).
# Pull: docker pull ghcr.io/banda-health/idempiere-db:develop
IDEMPIERE_DB_IMAGE=ghcr.io/banda-health/idempiere-db:develop
# IDEMPIERE_DB_PULL_POLICY=missing   # use always to refresh from registry

# CI-baked DB uses the same superuser password as root .env.example POSTGRES_PASSWORD.
# DB_UPSTREAM_ADMIN_PASSWORD=7d%opWw2N0^f3mG5OmH%

# Frozen dev image: ./dev.sh (snapshot mode) and ./dev.sh capture both use this reference.
IDEMPIERE_DEV_IMAGE=ghcr.io/banda-health/idempiere-dev:idempiere-12-eclipse-2026-03-v1

# Optional: override Jaspersoft Studio download URL (default: jasper-schulungen 6.20.3 Linux zip).
# JASPERSOFT_STUDIO_URL=https://jasper-schulungen.de/jasperstudio-standalone/6.20.3/com.jaspersoft.studio.rcp.product-linux.gtk.x86_64.zip
