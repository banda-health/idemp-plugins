IDEMPIERE_HOME=/opt/idempiere

# Host path to idemp-banda repo root (relative to dev-docker/ or absolute)
PLUGINS_MOUNT=..

# In-container path where the repo is mounted
PLUGINS_CONTAINER_DIR=/workspace/idemp-banda

# Optional: override host UID/GID baked into the developer user at image build time.
# eclipse.sh --build sets these from id -u / id -g when unset.
# HOST_UID=1000
# HOST_GID=1000

# Build output (target/, lib/, testing/) is stored in Docker named volumes overlaid on
# the mount (see docker-compose.build-overlays.yml), not on the host checkout.

# Run pending DB migrations when the dev container starts (via docker-entrypoint.sh)
RUN_MIGRATIONS_ON_START=true

# Host port -> container 8080 (iDempiere HTTP)
IDEMPIERE_HTTP_PORT=8080

# iDempiere always uses localhost:5432 inside the container.
# DB_HOST_PORT is the Postgres port on your machine (when DB_TARGET=host).
DB_TARGET=host
DB_HOST_PORT=5432

# Credentials shown in iDempiere UI (any value works on localhost; PgBouncer ignores them).
DB_DEFAULT_USER=adempiere
DB_DEFAULT_PASSWORD=adempiere

# Real upstream app database (iDempiere UI can still say "idempiere").
DB_UPSTREAM_DATABASE=idempiere
DB_UPSTREAM_USER=adempiere
DB_UPSTREAM_PASSWORD=adempiere

# Real upstream admin database (Server Setup template1 check).
DB_UPSTREAM_ADMIN_DATABASE=template1
DB_UPSTREAM_ADMIN_USER=postgres
DB_UPSTREAM_ADMIN_PASSWORD=postgres

# When DB_TARGET=compose (uncomment postgres service in compose file)
DB_COMPOSE_HOST=postgres

# Frozen image from scripts/capture-container-state.sh (used by docker-compose.snapshot.yml)
IDEMPIERE_DEV_IMAGE=dev-docker-idempiere:snapshot
