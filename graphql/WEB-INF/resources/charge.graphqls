type Charge {
  id: ID!
  client: Client!
  organization: Organization!
  isActive: Boolean!
  created: String! @dateFormat
  createdBy: User!
  description: String
  name: String
  isLocked: Boolean
  chargeType: ChargeType!
}

type ChargeConnection {
  results: [Charge!]!
  pagingInfo: PagingInfo
}

input ChargeInput {
  id: ID
  isActive: Boolean
  description: String
  name: String
  isLocked: Boolean
  chargeType: ChargeTypeInput
}