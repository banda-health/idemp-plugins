extend type Mutation {
	BH_VisitProcess(uuid: String!): BH_Visit
}

extend type BH_Visit {
	BH_Encounter: [BH_Encounter!]!
	C_Invoice: [C_Invoice!]!
	C_Order: [C_Order!]!
	C_Payment: [C_Payment!]!
	M_InOut: [M_InOut!]!
}

extend input BH_VisitInput {
	BH_Encounter: [BH_EncounterInput!]
	C_Invoice: [C_InvoiceInput!]
	C_Order: [C_OrderInput!]
	C_Payment: [C_PaymentInput!]
	M_InOut: [M_InOutInput!]
}