extend type Mutation {
	ChangeAccess(Access: ChangeAccessInput!): ChangeAccessResponse!
	ChangePassword(PasswordInfo: ChangePasswordInput!): Boolean!
	SignIn(Credentials: AuthenticationInput!): AuthenticationResponse!
}

type AuthenticationResponse {
	Token: String
	AD_User: AD_User
	SecurityQuestions: [String!]
}

input AuthenticationInput {
	Username: String!
	Password: String!
	AD_Language: String!
}

type ChangeAccessResponse {
	Token: String!
}

input ChangeAccessInput {
	AD_Client_UU: String!
	AD_Role_UU: String!
	AD_Org_UU: String!
	M_Warehouse_UU: String!
}

input ChangePasswordInput {
	Username: String!
	Password: String!
	NewPassword: String!
	SecurityQuestion: String
	Answer: String
}
