type AuthenticationResponse {
  token: String
  AD_Clients: [AD_Client!]!
  user: AD_User
  AD_Role: AD_Role
  securityQuestions: [String!]
}

input AuthenticationData {
  username: String!
  password: String!
  newPassword: String
  securityQuestion: String
  answer: String
  clientId: String
  roleId: String
  organizationId: String
  warehouseId: String
  language: String
}