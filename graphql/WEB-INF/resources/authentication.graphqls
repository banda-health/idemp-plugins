type AuthenticationResponse {
  token: String
  username: String
  clients: [AD_Client!]!
  user: AD_User
  roleId: String!
  needsToResetPassword: Boolean!
  securityQuestions: [String!]
}

input AuthenticationData {
  username: String!
  password: String!
  newPassword: String
  securityQuestion: String
  answer: String
  clientId: String
  roleId: String
  organizationId: String
  warehouseId: String
}