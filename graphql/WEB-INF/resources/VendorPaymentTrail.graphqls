extend type Query {
	VendorPaymentTrailGet(Page: Int, Size: Int, Sort: String, Filter: String): VendorPaymentTrailConnection!
}

type VendorPaymentTrailConnection {
	Results: [VendorPaymentTrail!]!
	PagingInfo: PagingInfo!
}

type VendorPaymentTrail {
	C_BPartner: C_BPartner!
	C_Invoice: C_Invoice
	C_Order: C_Order
	C_Payment: C_Payment
	# Date this record was created
	Created: DateTime!
	# User who created this records
	CreatedBy: AD_User!
	# Date this record happened
	Date: DateTime!
	Charged: BigDecimal
	OpenBalance: BigDecimal
	Paid: BigDecimal
	# Date this record was updated
	Updated: DateTime!
}
