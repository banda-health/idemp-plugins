extend type Query {
	PaymentTrailGet(Page: Int, Size: Int, Sort: String, Filter: String): PaymentTrailConnection!
}

type PaymentTrailConnection {
	Results: [PaymentTrail!]!
	PagingInfo: PagingInfo!
}

type PaymentTrail {
	Base_Reversal_C_Invoice: C_Invoice
	Base_Reversal_C_Payment: C_Payment
	BH_Visit: BH_Visit
	C_BPartner: C_BPartner!
	C_Invoice: C_Invoice
	C_Order: C_Order
	C_Payment: C_Payment
	# Date this record was created
	Created: DateTime!
	# User who created this records
	CreatedBy: AD_User!
	# Date this record happened
	Date: DateTime!
	Charged: BigDecimal
	OpenBalance: BigDecimal
	# Date used for ordering (usually either the created or updated)
	OrderingDate: DateTime!
	Paid: BigDecimal
	# Date this record was updated
	Updated: DateTime!
}
