extend type Mutation {
	BH_VisitProcess(uuid: String!, documentAction: String!): BH_Visit
}

extend type BH_Visit {
	BH_Encounters: [BH_Encounter!]
	C_Invoices: [C_Invoice!]
	C_Orders: [C_Order!]
	C_Payments: [C_Payment!]
	M_InOuts: [M_InOut!]
}

extend input BH_VisitInput {
	BH_Encounters: [BH_EncounterInput!]
	C_Invoices: [C_InvoiceInput!]
	C_Orders: [C_OrderInput!]
	C_Payments: [C_PaymentInput!]
	M_InOuts: [M_InOutInput!]
}
